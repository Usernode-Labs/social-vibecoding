# Standalone Caddy config for Usernode Social Vibecoding.
#
# Domain is injected via {$USERNODE_DOMAIN} substitution — set in `.env`
# and passed through by docker-compose.
#
# Routing model (no per-host config, no reload):
#   Every child app + per-PR staging preview is a subdomain of
#   USERNODE_DOMAIN. A single wildcard site maps the hostname to the target
#   container *name* deterministically:
#
#     myapp.<domain>              -> usernode-app-myapp        (prod app)
#     myapp--s42.<domain>         -> usernode-staging-myapp--42 (PR preview)
#
#   Those are exactly the container names the platform already gives its
#   containers (services/staging.js + app-creator.js), and Caddy reaches
#   them by name on the shared `usernode-net` Docker network. Adding or
#   removing a preview is just starting/stopping a container — there is no
#   Caddy state to mutate. (Older previews used a trailing `--<commitHash>`
#   segment; the map below still accepts it so in-flight URLs keep routing.)
#
# TLS: ONE wildcard cert for *.<domain> (plus the apex), issued via the
# ACME DNS-01 challenge. This replaces the previous on-demand, per-hostname
# HTTP-01 issuance. Why the switch:
#   - On-demand issued a fresh cert the first time each preview host was hit.
#     ZeroSSL's ACME backend routinely took 3-8 minutes to *finalize* the
#     authorization (its validators fetched our token in seconds, but the
#     authz stayed "pending" well past Caddy's 180s deadline), so the first
#     load of a preview was a black screen for minutes.
#   - A wildcard is a SINGLE cert regardless of how many previews exist, so
#     there is no per-host issuance at all: previews are served instantly by
#     an already-present cert. It also makes Let's Encrypt's 50-cert/week cap
#     irrelevant (one cert), so LE — fast and reliable for DNS-01 — is the
#     issuer again; the cap is what had forced the ZeroSSL detour.
#
# DNS-01 + acme-dns (why we don't write to the real zone):
#   DNS-01 means Caddy must publish a `_acme-challenge` TXT record. Our zone
#   is Namecheap-hosted `usernodelabs.org` (production), and Namecheap's only
#   DNS write API REPLACES the entire host-record set per call — a prod-zone
#   wipe risk on every renewal. Instead we delegate just
#   `_acme-challenge.social-vibecoding...` (one static CNAME, added by hand)
#   to a self-hosted acme-dns server. Caddy sets the challenge TXT there via
#   acme-dns's internal HTTP API; the production Namecheap records are never
#   touched. See acme-dns/config.cfg + caddy.Dockerfile (caddy-dns/acmedns).
#
# NOTE on `propagation_timeout -1` (in each tls block below): certmagic
# normally pre-checks that the challenge TXT is live by querying the zone's
# AUTHORITATIVE nameserver directly — i.e. our acme-dns at 144.76.85.53:53.
# That dial runs from INSIDE the Caddy container, and Docker's bridge has no
# hairpin NAT, so a container cannot reach the host's own public IP:published
# port → the check times out and issuance never even asks LE to validate.
# Disabling the self-check sidesteps that: acme-dns is authoritative and sets
# the TXT instantly (zero propagation lag), and LE's real validation runs
# from the public internet where 144.76.85.53:53 IS reachable. (We use the
# site-level `tls { dns ... }` form rather than the global `acme_dns` option
# specifically so we can set propagation_timeout per the challenge.)

# Reusable DNS-01 challenge config (acme-dns). Snippet so the apex and the
# wildcard site stay identical.
(acmedns_tls) {
	tls {
		dns acmedns {
			username {$ACME_DNS_USERNAME}
			password {$ACME_DNS_PASSWORD}
			subdomain {$ACME_DNS_SUBDOMAIN}
			server_url http://acme-dns:8081
		}
		propagation_timeout -1
		resolvers 1.1.1.1 8.8.8.8
	}
}

# Friendly "updating" page served straight from Caddy when the platform
# upstream stays unreachable past the retry hold (#711). 503 (not 502) +
# Retry-After so intermediaries treat it as transient, no-store so it can
# never stick in a browser/SW cache, and the inline script polls /health
# and reloads the moment the platform is back — nobody has to mash
# refresh. Imported by the apex error handler and by the :8999 fallback
# vhost at the bottom of this file.
(updating_page) {
	header Retry-After 5
	header Cache-Control "no-store"
	header Content-Type "text/html; charset=utf-8"
	respond <<HTML
		<!DOCTYPE html>
		<html lang="en">
		<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<meta name="robots" content="noindex">
		<title>Usernode is updating</title>
		<style>
		  body { margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #0f0a1e; color: #e9e4f7; text-align: center; }
		  .card { max-width: 26rem; padding: 2rem; }
		  .spinner { width: 2.5rem; height: 2.5rem; margin: 0 auto 1.25rem; border-radius: 50%; border: 3px solid rgba(139, 92, 246, 0.25); border-top-color: #8b5cf6; animation: spin 0.9s linear infinite; }
		  @keyframes spin { to { transform: rotate(360deg); } }
		  h1 { font-size: 1.25rem; margin: 0 0 0.5rem; font-weight: 600; }
		  p { margin: 0; color: #a99fc7; font-size: 0.95rem; line-height: 1.5; }
		</style>
		</head>
		<body>
		<div class="card">
		  <div class="spinner"></div>
		  <h1>Usernode is updating</h1>
		  <p>A new version of the platform is being deployed. You&#8217;ll be reconnected automatically &#8212; no need to refresh.</p>
		</div>
		<script>
		  (function poll() {
		    fetch('/health', { cache: 'no-store' })
		      .then(function (r) { if (r.ok) { location.reload(); } else { setTimeout(poll, 2000); } })
		      .catch(function () { setTimeout(poll, 2000); });
		  })();
		</script>
		</body>
		</html>
		HTML 503
}

# Active blue/green platform color for the apex + access-gate upstreams.
# Defines the (platform_upstream) and (platform_gate) snippets used below.
# Rewritten + gracefully reloaded by scripts/platform-rollout.sh on every
# zero-downtime deploy so the apex/gate cut over cleanly to the new color.
import /etc/caddy/active/platform-upstream.caddy

# ── Main platform ────────────────────────────────────────────────
{$USERNODE_DOMAIN} {
	import acmedns_tls

	# The active blue/green color (import platform_upstream, from
	# caddy/active/platform-upstream.caddy). The snippet keeps the #711
	# hold-and-retry: blue-green makes deploys themselves zero-downtime,
	# but a color crash-restarting outside a rollout still boots in ~4s,
	# and holding the dial reads as a latency bump instead of a 502.
	# Retrying is safe for non-idempotent requests: Caddy only retries
	# requests it never managed to send upstream.
	import platform_upstream

	encode gzip

	handle_errors {
		# Top-level document navigations during an extended outage (a
		# deploy overrunning the 30s hold above, or a genuinely failed
		# deploy) get the friendly self-refreshing page instead of bare
		# status text. Fetches/API calls keep the terse text + real
		# status code so the SPA's error handling is untouched, and
		# non-upstream-down errors keep the terse form for everyone.
		@updating {
			expression `{err.status_code} in [502, 503, 504]`
			header Sec-Fetch-Dest document
		}
		handle @updating {
			import updating_page
		}
		handle {
			respond "{err.status_code} {err.status_text}"
		}
	}
}

# ── Child apps + per-PR staging previews ─────────────────────────
# Served by the single *.<domain> wildcard cert (issued via the DNS-01
# challenge above). There is no per-host issuance, so no on-demand gate is
# needed: unknown labels simply map to a nonexistent upstream and 502 — at
# zero cert cost.
*.{$USERNODE_DOMAIN} {
	import acmedns_tls

	# Derive the upstream container name from the leftmost DNS label.
	# Staging is checked first because its label (slug--sID) also satisfies
	# the broader prod-app pattern. Slugs never contain `--` (the sanitizer
	# collapses runs of non-alphanumerics to a single `-`), so `--sID`
	# reliably separates the slug from the staging suffix. The optional
	# `(?:--[a-z0-9]+)?` matches the legacy `--<commitHash>` suffix so older
	# preview URLs keep routing to the (stable) container during transition;
	# either way only the session id maps to the container name.
	# {applink} is the platform shell's chromeless deep link for the app —
	# where an unauthenticated top-level visit is sent when the app
	# container itself answers 401 (see the handle_response block below).
	# Only production hosts get one; staging previews and the default row
	# map to the empty string, which the @chromeless matcher excludes.
	map {host} {upstream} {applink} {
		~^([a-z0-9-]+?)--s(\d+)(?:--[a-z0-9]+)?\. usernode-staging-${1}--${2} ""
		~^([a-z0-9-]+)\. usernode-app-${1} "https://{$USERNODE_DOMAIN}/#app/${1}/full"
		default usernode ""
	}

	# Per-app visibility gate. Every child-app / staging request is
	# pre-flighted against the platform before being proxied: view-public
	# apps get an instant 200 (one cached lookup, no session work);
	# view-private apps require an admin or member credential — the
	# scoped per-host access cookie, the shell's iframe token, or a
	# bounce through the apex /__access/authorize route which reads the
	# real platform session. See the decision tree atop GET /__caddy/access
	# in src/routes/internal.js. On a non-2xx the gate's response
	# (404 / authorize redirect / cookie-setting redirect) is returned to
	# the client verbatim and the app container is never reached.
	#
	# WebSocket gotcha: forward_auth's subrequest PRESERVES the original
	# Connection/Upgrade headers, so for a proxied WS handshake the gate
	# check arrives at usernode:3000 as an upgrade-flagged request. Node
	# diverts those to the http server's 'upgrade' event — the platform
	# must re-dispatch non-/ws/* upgrades into its normal request chain
	# (see src/services/ws.js attach()) or the gate answers EOF and Caddy
	# 502s every WebSocket behind this wildcard. Keep that in mind before
	# "simplifying" either side; tests/ws-upgrade-redispatch.test.js
	# guards the platform half.
	#
	# Upstream is the active blue/green color (import platform_gate, from
	# caddy/active/platform-upstream.caddy) so the gate flips together
	# with the apex on a zero-downtime deploy. The snippet keeps the #711
	# hold-and-retry so a color crash-restart doesn't 502 every app
	# subdomain for the boot window.
	import platform_gate

	# Chromeless-view rescue for direct/shared links (issue: bare
	# "Not authenticated" on app subdomains). Child apps auth via the
	# shell-injected iframe token, so an address-bar visit that reaches
	# the container tokenless gets a 401 — from the scaffold's landing
	# page or an agent-written JSON error, depending on the app's
	# (vendored, never retro-updated) server.js. Intercept exactly that
	# case: a 401 answered to a TOP-LEVEL document navigation
	# (Sec-Fetch-Dest: document — iframe loads are `iframe`, assets are
	# `script`/`style`/`image`, API fetches are `empty`, and curl/tools
	# send nothing) on a production host ({applink} non-empty) becomes a
	# redirect to the platform shell's chromeless view, where the app is
	# embedded with a real token and just works. The original request URI
	# rides along as the fragment's FINAL `?path=` param (#743) — {uri} is
	# already wire-encoded and can never contain `#`, and the shell
	# extracts everything after the first `path=` verbatim, so no encoding
	# step is needed (or possible) here. Everything else —
	# including tokenless apps that deliberately serve a public page
	# (they respond 200, so handle_response never fires; the #477 bridge
	# pill keeps handling those) — passes through verbatim.
	reverse_proxy {upstream}:3000 {
		# Fail FAST on a dead app container (dial only — deliberately no
		# lb_try hold here, unlike the platform proxies): a dead APP
		# should drop into the friendly /__app_unavailable flow below
		# immediately, not stall for a retry window (#711).
		transport http {
			dial_timeout 2s
		}
		@unauth status 401
		handle_response @unauth {
			@chromeless {
				header Sec-Fetch-Dest document
				not vars {applink} ""
			}
			route {
				redir @chromeless {applink}?path={uri} 302
				copy_response
			}
		}
	}

	encode gzip

	# Friendly recovery page for dead app containers (#426). A stopped /
	# crashed / mid-redeploy container makes the reverse_proxy above fail
	# with 502 (or 503/504); instead of the raw status text, rewrite those
	# to the platform's /__app_unavailable route (src/routes/app-error.js),
	# which serves a neutral auto-retrying "this app is restarting" page
	# AND kicks the production watchdog's on-demand heal for the slug
	# (src/services/app-heal.js). reverse_proxy preserves the original
	# Host, so the platform knows which app subdomain the user was on.
	# Every other error code keeps the terse respond below.
	#
	# Platform-down fallback (#711): if the platform ITSELF is
	# unreachable (a deploy overrunning the forward_auth hold window, or
	# a failed deploy), the /__app_unavailable proxy would fail too and
	# Caddy would emit its blank default 502. Instead the proxy carries a
	# second upstream — the :8999 self-vhost at the bottom of this file,
	# which serves the static "Usernode is updating" page. `lb_policy
	# first` keeps the platform-rendered page authoritative whenever the
	# platform is up; `fail_duration` is required for the fallback to
	# actually engage (without passive-health memory, `first` would
	# re-select the dead usernode upstream for the whole try window and
	# never reach the second upstream). The 10s down-memory is scoped to
	# THIS proxy block — the apex/gate proxies configure no passive
	# health checks, so their hold-and-retry behaviour is unaffected.
	handle_errors {
		@upstream_down expression `{err.status_code} in [502, 503, 504]`
		handle @upstream_down {
			rewrite * /__app_unavailable
			reverse_proxy usernode:3000 127.0.0.1:8999 {
				lb_policy first
				lb_try_duration 4s
				lb_try_interval 250ms
				fail_duration 10s
				transport http {
					dial_timeout 2s
				}
			}
		}
		handle {
			respond "{err.status_code} {err.status_text}"
		}
	}
}

# ── Static "updating" fallback (internal) ────────────────────────
# Second upstream for the wildcard error handler above: when the platform
# can't render the friendly app-unavailable page because it is itself
# down, this vhost serves the same static "Usernode is updating" page the
# apex error handler uses. Plain HTTP on a port compose never publishes
# (only 80/443 are mapped), so it's reachable in-container / on the
# docker network only — and it holds no state or secrets either way.
:8999 {
	import updating_page
}

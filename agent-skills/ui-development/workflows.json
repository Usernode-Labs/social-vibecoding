{
  "version": 3,
  "scope": "social-vibecoding-react-shell",
  "fallback": "route",
  "excludes": [
    "child-app source",
    "app-factory scaffold",
    "hosted usernode-native/v1 consumers"
  ],
  "changedFileScope": [
    "AGENTS.md",
    "CLAUDE.md",
    ".gitignore",
    ".github/workflows/frontend-checks.yml",
    "NATIVE-BRIDGE.md",
    "agent-skills/",
    "frontend/",
    "public/",
    "server.js",
    "tests/",
    "tool/"
  ],
  "workflows": {
    "harness": {
      "priority": 110,
      "description": "Maintain agent instructions, skills, discovery adapters, workflow routing, fitness evidence, or agent batteries.",
      "terms": [
        "agent harness",
        "harness fitness",
        "context budget",
        "agent skill",
        "agent-skills",
        "workflow resolver",
        "workflow router",
        "instruction adapter",
        "agent battery",
        "agents.md",
        "claude.md"
      ],
      "paths": [
        "AGENTS.md",
        "CLAUDE.md",
        ".gitignore",
        ".github/workflows/frontend-checks.yml",
        "agent-skills/",
        "tool/",
        "frontend/scripts/check-harness",
        "frontend/scripts/check-context-budget",
        "frontend/scripts/harness-fingerprint",
        "frontend/scripts/run-agent-battery",
        "frontend/scripts/run-live-agent-battery",
        "frontend/scripts/ui-workflow",
        "frontend/design-system/agent-battery.tasks.json",
        "frontend/design-system/harness-fitness",
        "frontend/design-system/context-budget"
      ],
      "suppresses": [
        "review"
      ],
      "context": [
        "AGENTS.md",
        "agent-skills/harness-fitness/SKILL.md",
        "agent-skills/ui-development/SKILL.md",
        "agent-skills/ui-development/workflows.json",
        "frontend/AGENTS.md",
        "frontend/design-system/context-budget.json",
        "frontend/scripts/check-context-budget.mjs",
        "frontend/scripts/check-harness-fitness.mjs",
        "frontend/scripts/check-harness-integrity.mjs",
        "frontend/scripts/run-agent-battery.mjs"
      ],
      "checks": [
        "npm run check:harness-integrity",
        "npm run check:harness-fitness",
        "npm run check:progressive-context",
        "npm run check:context-budget",
        "npm run test:harness",
        "npm run test:agent-battery"
      ],
      "evidence": [
        "Every harness-owned routing case resolves to the expected workflow without stealing unrelated work.",
        "Supported Claude and Codex adapters resolve the same canonical skills.",
        "Fitness findings remain advisory while the separate context budget blocks measured byte-policy violations."
      ],
      "stop": "Stop before recording a new baseline or portability claim without accepted exact-state and matched-runner evidence."
    },
    "authority": {
      "priority": 100,
      "description": "Change tokens, component contracts, registry distribution, or design-system policy.",
      "terms": [
        "token",
        "registry",
        "design-system",
        "design system",
        "authority",
        "primitive",
        "exception"
      ],
      "paths": [
        "frontend/design-system/",
        "frontend/design-system.manifest.json",
        "frontend/registry.json"
      ],
      "context": [
        "agent-skills/ui-development/references/authority.md",
        "frontend/design-system/authority.json",
        "frontend/design-system/interface-laws.md",
        "frontend/design-system/context-budget.json",
        "frontend/design-system/tokens.json",
        "frontend/design-system/catalog.json",
        "frontend/registry.json",
        "frontend/design-system/exceptions.json"
      ],
      "checks": [
        "npm run check:tokens",
        "npm run check:design-system",
        "npm run check:registry",
        "npm run check:style-policy",
        "npm run check:context-budget",
        "npm run check:harness-integrity",
        "npm run test:agent-battery"
      ],
      "evidence": [
        "Generated token CSS, catalog, and CLI registry remain reproducible.",
        "Every style exception is exact, owned, justified, expiring, and count-bounded.",
        "Context ratchets are measured, bucket membership is explicit, and the owner ceiling has no exception path.",
        "The deterministic agent battery records complete enforcement."
      ],
      "stop": "Stop for design-system approver review before adding a new token, primitive, relationship category, or exception category."
    },
    "contract": {
      "priority": 90,
      "description": "Change native bridge, iframe, auth, service-worker, offline, or history contracts.",
      "terms": [
        "bridge",
        "iframe",
        "service worker",
        "service-worker",
        "offline",
        "cookie",
        "auth",
        "history",
        "deep link",
        "deep-link",
        "native"
      ],
      "paths": [
        "NATIVE-BRIDGE.md",
        "frontend/@/lib/native-bridge",
        "frontend/@/lib/auth",
        "frontend/@/lib/external-links",
        "frontend/src/react-service-worker",
        "frontend/public/react-sw",
        "public/usernode-bridge",
        "public/sw.js"
      ],
      "context": [
        "frontend/AGENTS.md",
        "NATIVE-BRIDGE.md",
        "docs/react-migration.md",
        "frontend/scripts/check-cutover-contract.mjs"
      ],
      "checks": [
        "npm run check:harness",
        "npm run test:native-bridge-contract",
        "npm run test:service-worker-contract",
        "npm run test:e2e",
        "npm run check:cutover-contract"
      ],
      "evidence": [
        "Compatibility behavior is tested at the adapter and browser boundary.",
        "Security, origin, cookie, cache, and history assumptions are documented.",
        "Any skipped host proof remains explicit."
      ],
      "stop": "Stop before deployment or legacy retirement when required host evidence is absent."
    },
    "consolidation": {
      "priority": 85,
      "description": "Compare overlapping component semantics and decide keep, extend, supersede, or remove without forcing unrelated jobs together.",
      "terms": [
        "consolidate",
        "consolidation",
        "duplicate component",
        "overlap",
        "similar component",
        "supersede",
        "deprecate",
        "remove component",
        "component audit"
      ],
      "paths": [
        "frontend/design-system/relationships.json"
      ],
      "context": [
        "agent-skills/ui-development/references/authority.md",
        "agent-skills/ui-development/references/consolidation.md",
        "frontend/design-system/catalog.json",
        "frontend/design-system/relationships.json"
      ],
      "checks": [
        "npm run check:design-system",
        "npm run check:relationships",
        "npm run test:storybook",
        "npm run test:e2e"
      ],
      "evidence": [
        "The decision is based on user job and behavior, not appearance or markup alone.",
        "Substitution boundaries and distinct responsibilities are recorded.",
        "Every removal or supersession has usage evidence and a migration path."
      ],
      "stop": "Stop for collaborative review before merging, superseding, or removing patterns whose user jobs are not demonstrably equivalent."
    },
    "content": {
      "priority": 80,
      "description": "Create or review user-facing labels, states, instructions, errors, and accessibility names.",
      "terms": [
        "copy",
        "content",
        "wording",
        "label",
        "microcopy",
        "empty state",
        "error message",
        "accessibility name",
        "rename"
      ],
      "paths": [
        "frontend/design-system/content-guidelines.md",
        "frontend/design-system/content-exceptions.json"
      ],
      "context": [
        "frontend/design-system/content-guidelines.md",
        "frontend/design-system/content-exceptions.json"
      ],
      "checks": [
        "npm run check:content",
        "npm run test:content",
        "npm run test:storybook"
      ],
      "evidence": [
        "Copy is reviewed by named content failure mode and information layer.",
        "Visible labels and accessibility names satisfy the registered contract.",
        "Exceptions are exact, owned, justified, expiring, and count-bounded."
      ],
      "stop": "Stop before adding reusable terminology or a new content exception without authority review."
    },
    "component": {
      "priority": 70,
      "description": "Create or change a reusable shell component or platform pattern.",
      "terms": [
        "component",
        "story",
        "storybook",
        "variant",
        "pattern",
        "card",
        "reuse",
        "extend"
      ],
      "paths": [
        "frontend/@/components/",
        ".stories.tsx"
      ],
      "context": [
        "agent-skills/ui-development/references/authority.md",
        "frontend/design-system/interface-laws.md"
      ],
      "discovery": [
        "npm run query:design-system -- \"<component name, id, variant, or job>\"",
        "npm run query:design-system -- --related \"<component name, id, variant, or job>\""
      ],
      "checks": [
        "npm run check:design-system",
        "npm run check:style-policy",
        "npm run check:harness",
        "npm run test:storybook",
        "npm run typecheck"
      ],
      "evidence": [
        "Reuse, extension, or new-pattern decision is stated.",
        "Named Storybook states cover variants and responsive/accessibility states.",
        "Catalog metadata names ownership, maturity, tokens, data boundary, and deprecation."
      ],
      "stop": "Stop if an unsupported interaction requires a new owned pattern; record the gap for approval."
    },
    "review": {
      "priority": 60,
      "description": "Review, polish, or release a completed shell slice.",
      "terms": [
        "review",
        "polish",
        "release",
        "handoff",
        "final",
        "taste",
        "ui.sh"
      ],
      "paths": [],
      "context": [
        "agent-skills/ui-development/references/evidence.md",
        "agent-skills/ui-development/references/review.md"
      ],
      "checks": [
        "npm run check:ui"
      ],
      "evidence": [
        "Automated checks pass independently of agent instructions.",
        "Storybook and browser evidence cover the changed states.",
        "Optional taste findings are recorded without overriding mechanical authority."
      ],
      "stop": "Stop if required evidence is missing; optional polish tools cannot waive a mechanical gate."
    },
    "route": {
      "priority": 10,
      "description": "Migrate or change a platform-owned shell route.",
      "terms": [
        "route",
        "page",
        "screen",
        "navigation",
        "responsive"
      ],
      "paths": [
        "frontend/@/features/",
        "server.js",
        "tests/"
      ],
      "context": [
        "frontend/AGENTS.md",
        "frontend/design-system/catalog.json",
        "docs/react-migration.md",
        "frontend/@/lib/routes.ts"
      ],
      "checks": [
        "npm run check:style-policy",
        "npm run check:harness",
        "npm run typecheck",
        "npm run test:e2e",
        "npm run test:production-guard"
      ],
      "evidence": [
        "Applicable loading, success, empty/error, permission/capability, mobile, and desktop states are exercised.",
        "Route, hash, history, and back behavior remain compatible.",
        "The route uses owned adapters rather than endpoints or platform globals."
      ],
      "stop": "Stop before retiring a legacy route until the route-parity record is complete and reviewed."
    }
  },
  "routingCases": [
    {
      "id": "harness-task",
      "task": "Audit whether the agent harness is equally usable by Claude and Codex",
      "files": [],
      "expected": ["harness"],
      "forbidden": ["review", "route"]
    },
    {
      "id": "harness-path",
      "task": "",
      "files": ["tool/ui-workflow.mjs"],
      "expected": ["harness"],
      "forbidden": ["route", "review"]
    },
    {
      "id": "canonical-skill-path",
      "task": "",
      "files": ["agent-skills/ui-development/workflows.json"],
      "expected": ["harness"],
      "forbidden": ["route"]
    },
    {
      "id": "root-instructions",
      "task": "",
      "files": ["AGENTS.md"],
      "expected": ["harness"],
      "forbidden": ["route"]
    },
    {
      "id": "native-contract",
      "task": "",
      "files": ["NATIVE-BRIDGE.md"],
      "expected": ["contract"],
      "forbidden": ["harness"]
    },
    {
      "id": "component-review",
      "task": "Polish Home app shortcut component copy and add Storybook state",
      "files": [],
      "expected": ["content", "component", "review"],
      "forbidden": ["harness"]
    },
    {
      "id": "ordinary-route",
      "task": "Change the Apps route",
      "files": ["frontend/@/features/apps/apps-route.tsx"],
      "expected": ["route"],
      "forbidden": ["harness"]
    },
    {
      "id": "public-contract",
      "task": "",
      "files": ["public/sw.js"],
      "expected": ["contract"],
      "forbidden": ["harness"]
    },
    {
      "id": "server-fallback",
      "task": "",
      "files": ["server.js"],
      "expected": ["route"],
      "forbidden": ["harness"]
    },
    {
      "id": "test-contract",
      "task": "Review native bridge compatibility",
      "files": ["tests/usernode-bridge.test.js"],
      "expected": ["contract"],
      "forbidden": ["harness"]
    }
  ],
  "gateGraph": {
    "defaultMode": "parallel",
    "machineUnits": {
      "default": 16,
      "overrideEnv": "UI_GATE_MACHINE_UNITS"
    },
    "stages": [
      { "id": "root-suite", "step": 1, "units": 1, "priority": 90 },
      { "id": "lint", "step": 2, "units": 1, "priority": 10 },
      { "id": "tokens", "step": 3, "units": 1, "priority": 10 },
      { "id": "design-system", "step": 4, "units": 1, "priority": 10 },
      { "id": "relationships", "step": 5, "units": 1, "priority": 10 },
      { "id": "registry", "step": 6, "units": 1, "priority": 10 },
      { "id": "style-policy", "step": 7, "units": 1, "priority": 10 },
      { "id": "content", "step": 8, "units": 1, "priority": 10 },
      { "id": "content-tests", "step": 9, "units": 1, "priority": 20 },
      { "id": "harness-integrity", "step": 10, "units": 1, "priority": 20 },
      { "id": "harness-fitness", "step": 11, "units": 1, "priority": 10 },
      { "id": "progressive-context", "step": 12, "units": 1, "priority": 20 },
      { "id": "context-budget", "step": 13, "units": 1, "priority": 20 },
      { "id": "harness-policy", "step": 14, "units": 1, "priority": 10 },
      { "id": "harness-tests", "step": 15, "units": 1, "priority": 20 },
      { "id": "agent-battery", "step": 16, "units": 1, "priority": 20 },
      { "id": "typecheck", "step": 17, "units": 1, "priority": 20 },
      { "id": "native-bridge", "step": 18, "units": 2, "priority": 60 },
      { "id": "build", "step": 19, "units": 2, "priority": 80 },
      { "id": "service-worker", "step": 20, "units": 2, "priority": 70, "dependsOn": ["build"] },
      { "id": "browser-matrix", "step": 21, "units": 9, "priority": 100 },
      { "id": "production-guard", "step": 22, "units": 3, "priority": 75 },
      { "id": "production-smoke", "step": 23, "units": 2, "priority": 65 },
      { "id": "cutover-contract", "step": 24, "units": 1, "priority": 50, "dependsOn": ["service-worker"] },
      { "id": "bundle-budget", "step": 25, "units": 1, "priority": 50, "dependsOn": ["service-worker"] },
      { "id": "storybook-tests", "step": 26, "units": 4, "priority": 85 },
      { "id": "storybook-build", "step": 27, "units": 2, "priority": 55 }
    ]
  },
  "fullGate": [
    {
      "cwd": "root",
      "command": "npm test",
      "ciEvidence": "name: Run authoritative root suite",
      "kind": "test"
    },
    {
      "cwd": "frontend",
      "command": "npm run lint",
      "ciEvidence": "npm run lint"
    },
    {
      "cwd": "frontend",
      "command": "npm run check:tokens",
      "ciEvidence": "npm run check:tokens"
    },
    {
      "cwd": "frontend",
      "command": "npm run check:design-system",
      "ciEvidence": "npm run check:design-system"
    },
    {
      "cwd": "frontend",
      "command": "npm run check:relationships",
      "ciEvidence": "npm run check:relationships"
    },
    {
      "cwd": "frontend",
      "command": "npm run check:registry",
      "ciEvidence": "npm run check:registry"
    },
    {
      "cwd": "frontend",
      "command": "npm run check:style-policy",
      "ciEvidence": "npm run check:style-policy"
    },
    {
      "cwd": "frontend",
      "command": "npm run check:content",
      "ciEvidence": "npm run check:content"
    },
    {
      "cwd": "frontend",
      "command": "npm run test:content",
      "ciEvidence": "npm run test:content",
      "kind": "test"
    },
    {
      "cwd": "frontend",
      "command": "npm run check:harness-integrity",
      "ciEvidence": "npm run check:harness-integrity"
    },
    {
      "cwd": "frontend",
      "command": "npm run check:harness-fitness",
      "ciEvidence": "npm run check:harness-fitness"
    },
    {
      "cwd": "frontend",
      "command": "npm run check:progressive-context",
      "ciEvidence": "npm run check:progressive-context"
    },
    {
      "cwd": "frontend",
      "command": "npm run check:context-budget",
      "ciEvidence": "npm run check:context-budget"
    },
    {
      "cwd": "frontend",
      "command": "npm run check:harness",
      "ciEvidence": "npm run check:harness"
    },
    {
      "cwd": "frontend",
      "command": "npm run test:harness",
      "ciEvidence": "npm run test:harness",
      "kind": "test"
    },
    {
      "cwd": "frontend",
      "command": "npm run test:agent-battery",
      "ciEvidence": "npm run test:agent-battery",
      "kind": "test"
    },
    {
      "cwd": "frontend",
      "command": "npm run typecheck",
      "ciEvidence": "npm run typecheck"
    },
    {
      "cwd": "frontend",
      "command": "npm run test:native-bridge-contract",
      "ciEvidence": "npm run test:native-bridge-contract",
      "kind": "test",
      "resources": {
        "ports": [
          { "name": "native-bridge-server", "default": 4299, "overrideEnv": "UI_GATE_NATIVE_PORT", "commandEnv": "PLAYWRIGHT_PORT" }
        ],
        "artifacts": [
          { "name": "native-bridge-output", "default": ".artifacts/ui-gate/playwright/native-bridge", "commandEnv": "PLAYWRIGHT_OUTPUT_DIR" }
        ],
        "workers": {
          "serial": "playwright-default",
          "parallel": 1,
          "overrideEnv": "UI_GATE_NATIVE_WORKERS",
          "commandEnv": "PLAYWRIGHT_WORKERS"
        }
      }
    },
    {
      "cwd": "frontend",
      "command": "npm run build",
      "ciEvidence": "name: Build immutable React shell",
      "kind": "build"
    },
    {
      "cwd": "frontend",
      "command": "npm run test:service-worker-contract",
      "ciEvidence": "react-service-worker.spec.ts",
      "kind": "test",
      "resources": {
        "ports": [
          { "name": "production-preview", "default": 4363, "overrideEnv": "UI_GATE_SERVICE_WORKER_PORT", "commandEnv": "PLAYWRIGHT_SW_PORT" }
        ],
        "artifacts": [
          { "name": "service-worker-output", "default": ".artifacts/ui-gate/playwright/service-worker", "commandEnv": "PLAYWRIGHT_OUTPUT_DIR" }
        ],
        "workers": 1
      }
    },
    {
      "cwd": "frontend",
      "command": "npm run test:e2e",
      "ciEvidence": "npm run test:e2e",
      "kind": "test",
      "resources": {
        "ports": [
          { "name": "browser-matrix-server", "default": 4298, "overrideEnv": "UI_GATE_E2E_PORT", "commandEnv": "PLAYWRIGHT_PORT" }
        ],
        "artifacts": [
          { "name": "browser-matrix-output", "default": ".artifacts/ui-gate/playwright/browser-matrix", "commandEnv": "PLAYWRIGHT_OUTPUT_DIR" }
        ],
        "workers": {
          "serial": "playwright-default",
          "parallel": 8,
          "overrideEnv": "UI_GATE_E2E_WORKERS",
          "commandEnv": "PLAYWRIGHT_WORKERS"
        }
      }
    },
    {
      "cwd": "frontend",
      "command": "npm run test:production-guard",
      "ciEvidence": "npm run test:production-guard",
      "kind": "test",
      "resources": {
        "ports": [
          { "name": "production-review-server", "default": 4274 }
        ],
        "artifacts": [
          { "name": "production-review-output", "default": ".artifacts/ui-gate/playwright/production-review", "commandEnv": "PLAYWRIGHT_OUTPUT_DIR" }
        ],
        "workers": {
          "serial": "playwright-default",
          "parallel": 2,
          "overrideEnv": "UI_GATE_PRODUCTION_GUARD_WORKERS",
          "commandEnv": "PLAYWRIGHT_WORKERS"
        }
      }
    },
    {
      "cwd": "frontend",
      "command": "npm run test:production-smoke",
      "ciEvidence": "npm run test:production-smoke",
      "kind": "test",
      "resources": {
        "ports": [
          { "name": "production-smoke-server", "default": 4275 }
        ],
        "artifacts": [
          { "name": "production-smoke-output", "default": ".artifacts/ui-gate/playwright/production-smoke", "commandEnv": "PLAYWRIGHT_OUTPUT_DIR" }
        ],
        "workers": 1
      }
    },
    {
      "cwd": "frontend",
      "command": "npm run check:cutover-contract",
      "ciEvidence": "npm run check:cutover-contract"
    },
    {
      "cwd": "frontend",
      "command": "npm run check:bundle",
      "ciEvidence": "npm run check:bundle"
    },
    {
      "cwd": "frontend",
      "command": "npm run test:storybook",
      "ciEvidence": "npm run test:storybook",
      "kind": "test",
      "resources": {
        "ports": [
          { "name": "storybook-browser-server", "allocation": "dynamic" }
        ],
        "workers": "vitest-default"
      }
    },
    {
      "cwd": "frontend",
      "command": "npm run check:storybook-build",
      "ciEvidence": "npm run check:storybook-build",
      "kind": "build"
    }
  ]
}

{
  "version": 1,
  "modes": {
    "run": {
      "sandbox": "allow-scripts",
      "directives": [
        ["default-src", "'none'"],
        ["style-src", "'unsafe-inline'", "{site}"],
        ["img-src", "data:", "{site}"],
        ["font-src", "data:", "{site}"],
        ["script-src", "'unsafe-inline'"],
        ["connect-src", "'none'"],
        ["frame-src", "'none'"],
        ["form-action", "'none'"],
        ["base-uri", "'none'"]
      ]
    },
    "static": {
      "sandbox": "",
      "directives": [
        ["default-src", "'none'"],
        ["style-src", "'unsafe-inline'", "{site}"],
        ["img-src", "data:", "{site}"],
        ["font-src", "data:", "{site}"],
        ["script-src", "'none'"],
        ["connect-src", "'none'"],
        ["frame-src", "'none'"],
        ["form-action", "'none'"],
        ["base-uri", "'none'"]
      ]
    }
  },
  "helper": {
    "sandbox": "allow-scripts",
    "script-src": "'nonce-{nonce}'"
  },
  "attachmentView": "sandbox allow-scripts"
}

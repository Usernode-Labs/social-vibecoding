# Usernode Social Vibecoding — environment template.
# For local-dev, copy to .env and fill in values. For production the
# real .env is generated on the VPS by .github/workflows/deploy.yml
# from GitHub repo secrets — see README "Standalone deployment".

# ── Auth ──────────────────────────────────────────────────────
# ADMIN_USERNAME / ADMIN_PASSWORD log you in as the platform admin.
# SESSION_SECRET signs express-session cookies; rotate it and everyone
# gets logged out.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
SESSION_SECRET=changeme-64-char-random-string

# ── Domain ────────────────────────────────────────────────────
# What hostname this instance runs at. Child apps get
# <slug>.<USERNODE_DOMAIN> (staging: <slug>--<user>--<sha>.<USERNODE_DOMAIN>),
# so DNS needs an A record for both the apex *and* the wildcard.
# Also templated into scaffolded apps' CLAUDE.md and "Open in
# Usernode" landing pages, and used by Caddy for the main vhost.
USERNODE_DOMAIN=usernode.example.com

# ── Database ──────────────────────────────────────────────────
# In the standalone docker-compose, the `usernode` service has its
# DATABASE_URL injected inline (pointing at the `usernode-db` service
# in the same network), so you only need USERNODE_DB_PASSWORD here for
# compose variable substitution. For local-dev outside docker, set
# DATABASE_URL explicitly too.
DATABASE_URL=postgres://usernode:localdev@usernode-db:5432/usernode
USERNODE_DB_PASSWORD=localdev

# ── JWT (shared with child apps for iframe auth) ──────────────
# Also the KDF input for the AES key that encrypts user-provided
# Anthropic keys (BYOK, src/services/secrets.js). Rotating invalidates
# every stored BYOK key.
JWT_SECRET=changeme-64-char-random-string

# ── GitHub App (for branches, PRs, pushes, issues) ────────────
# GITHUB_PRIVATE_KEY should be a single line with literal \n escape
# sequences — the process reads it and un-escapes at startup.
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=

# ── GitHub Bot PAT ────────────────────────────────────────────
# App tokens can't create repos on user accounts, so we also need a
# bot-user PAT with `repo` scope. Same token powers the /api/feedback
# "file a GitHub issue" flow — needs Issues:write on the feedback repo.
GITHUB_BOT_TOKEN=

# ── Self-hosting (platform repo URL) ──────────────────────────
# GitHub URL of *this* platform's source repo. Used by:
#   - the in-app feedback flow (file issues here)
#   - the import-flow guard (refuse to import this repo as a child app
#     once self-hosting is fully wired)
#   - the self-app boot seed
# Defaults to the canonical Usernode-Labs repo; override iff you're
# self-hosting from your own fork.
# USERNODE_PLATFORM_REPO=https://github.com/Usernode-Labs/social-vibecoding

# ── LLM (optional — BYOK fallback exists) ─────────────────────
# Admin-funded Anthropic key. Users can override with their own via
# the settings modal (BYOK); when they do their usage doesn't count
# against the admin budget. Leaving this blank makes the instance
# BYOK-only.
ANTHROPIC_API_KEY=

# ── Docker (child-app isolation) ──────────────────────────────
# Name of the Docker network child-app containers + Claude Code
# workers are attached to. Must match the network defined in
# docker-compose.yml — set DOCKER_NETWORK if you diverge from the
# default so worker.js + docker.js spawn onto the right network.
# DOCKER_NETWORK=usernode-net

# ── Local-dev convenience ─────────────────────────────────────
# When set, the platform returns http://localhost:<hostport> URLs for
# child apps instead of https://<slug>.<USERNODE_DOMAIN> — useful when
# running the whole stack on your laptop where Caddy can't issue real
# Let's Encrypt certs and DNS doesn't resolve. Leave blank in production.
# USERNODE_LOCAL_DEV=1

# ── Usernode sidecar node ──────────────────────────────────────
# RPC URL for the Usernode sidecar (signature verification, wallet ops).
# In production docker-compose, this is set to http://usernode-node:3000
# automatically. For local dev outside Docker, point at a natively
# running node or override via NODE_RPC_URL in the environment.
# NODE_RPC_URL=http://localhost:3000

# Wallet linking: app public key + secret key for on-chain tx verification.
# Generate with: node scripts/generate-keypair.js --env (from dapp-starter)
# USERNODE_APP_PUBKEY=ut1...
# USERNODE_APP_SECRET_KEY=utsk1...

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Scaling / concurrency tunables ────────────────────────────
# All optional; the values below are the built-in defaults. Raise them
# (and the matching container limits in docker-compose.yml) to support
# more concurrent dev sessions. In prod these are set by the deploy
# workflow from GitHub repo vars; locally set them here.
#
# Platform-wide ceiling on active+promoted sessions. Each session can
# hold a warm worker container + a staging container, so this bounds
# host resource fan-out more than user count does.
# MAX_GLOBAL_SESSIONS=25
# Per-user ceiling on active+promoted sessions.
# MAX_USER_SESSIONS=3
# Per-session worker container limits (passed to `docker run`). Shrink
# to fit more concurrent warm workers on one box. Docker memory units:
# use e.g. 1280m / 2g (avoid decimals like 1.25g).
# WORKER_MEMORY=2g
# WORKER_CPUS=2
# How long a worker sits idle before eviction (ms). Lower it under load
# to reclaim worker RAM sooner; the tradeoff is a cold re-bootstrap on
# the next message. Default 600000 (10 min).
# WORKER_IDLE_EVICTION_MS=600000
# Postgres connection pool size (pg Pool.max). Widen alongside the
# usernode-db container's CPU/memory limits. Default 10.
# DB_POOL_MAX=10
# Session auto-pause: a background sweeper flips idle 'active' sessions
# to 'paused' so they stop counting against the session caps (the CC
# volume + branch + PR + staging preview are all kept; reopening auto-
# resumes). Pause is cheap (no staging teardown) and the dev-chat
# heartbeat keeps last_activity_at fresh while the tab is open, so this
# is tuned to line up with WORKER_IDLE_EVICTION_MS (~5 min after the user
# actually leaves). Default 5 min; set to 0 to disable.
# SESSION_AUTOPAUSE_IDLE_MS=300000
# Staging GC: pause keeps the staging preview up for cheap resumes, so a
# separate, longer sweeper reclaims the staging container + cloned DB
# once a session has been cold this long (promoted/merging sessions are
# exempt — their preview backs group voting). Default 6h; 0 disables.
# STAGING_IDLE_TEARDOWN_MS=21600000
# How often the session sweeper scans for idle sessions. Default 60s.
# SESSION_SWEEP_INTERVAL_MS=60000
# When a user at their session cap reopens/resumes a paused session,
# auto-pause their least-recently-active session to make room instead of
# refusing. Set to false to keep the old hard 429. Default true.
# SESSION_LRU_ON_RESUME=true
# Demand-driven global-cap eviction. When the platform is at the global
# session cap and a new session is needed, pause the globally least-
# recently-active session that's been idle longer than this window (and
# isn't mid-turn) to free a slot immediately — instead of making the new
# user wait for the slow auto-pause. Protects anyone actively working.
# Default 15 min; set to 0 to disable (hard 429 at the global cap).
# SESSION_PRESSURE_GRACE_MS=900000
# Stale-promoted-PR policy. A promoted PR with no voting interest for
# PR_STALE_NOTIFY_MS gets its author a one-time "going stale" notification;
# if still untouched PR_STALE_GRACE_MS later it's auto-archived (reversible).
# Casting a vote revives it. Default: notify after 7d, archive 3d later.
# Set PR_STALE_NOTIFY_MS=0 to disable the policy entirely.
# PR_STALE_NOTIFY_MS=604800000
# PR_STALE_GRACE_MS=259200000
# Reversible-archive retention. Archiving keeps the CC volume + branch so
# /unarchive can restore a session; a background GC purges the CC volume
# (Claude's memory) only after this long. The row + branch survive, so
# unarchive still works afterward but starts a fresh chat. Default 30d;
# set to 0 to keep CC volumes forever (no hard GC).
# ARCHIVED_RETENTION_MS=2592000000
# How often the stale-PR / archived-GC sweeper runs (day-scale work, so
# infrequent). Default 1h.
# STALE_SWEEP_INTERVAL_MS=3600000

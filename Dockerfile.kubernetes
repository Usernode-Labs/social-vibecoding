# Install the one lockfile-pinned dependency tree used by both browser builds.
# This stage is mounted ephemerally into the asset commands below instead of
# being their parent: the generated-output snapshot therefore contains no
# node_modules layer for rootless BuildKit to restore when the runtime copies
# public/ out of it. `rw` lets Vite create its temporary config bundle; writes
# to a bind mount from another stage are discarded after the RUN.
FROM node:22-alpine AS asset-deps
WORKDIR /build/frontend
COPY frontend/package.json frontend/package-lock.json ./
# npm keeps a copy of every tarball it downloads. Left at its default
# (/root/.npm) that copy is committed to this layer beside node_modules and
# is half of what every build downloads to restore the layer; nothing reads
# it again. So it goes to a named directory that the same RUN removes.
RUN npm ci --ignore-scripts --cache /tmp/npm-cache && rm -rf /tmp/npm-cache

# Build every generated browser asset in a lightweight output stage. The
# outputs are intentionally excluded from the build context, so every
# Kubernetes image must create them itself.
#
# GIT_SHA is NOT declared yet, on purpose. Neither Vite pass reads the commit
# id and Tailwind only needs a document to scan, so the two expensive steps
# below are keyed by their inputs alone and BuildKit can answer them from its
# layer cache for any commit that left frontend/, public/ and the Tailwind
# config untouched. Declared above them, as it was, the id made every commit
# rebuild all three. This run therefore writes a `dev` document, and keeps the
# prerender bundle so the document can be written again once the id is known.
FROM node:22-alpine AS shell
WORKDIR /build
COPY frontend ./frontend
COPY scripts/shell-stamp.js ./scripts/shell-stamp.js
COPY scripts/language-packs.js ./scripts/language-packs.js
COPY src/services/countries.json ./src/services/countries.json
RUN --mount=type=bind,from=asset-deps,source=/build/frontend/node_modules,target=/build/frontend/node_modules,rw \
    node frontend/scripts/build-shell.mjs --keep-prerender

# Compile Tailwind in the same stage, only after the current shell has been
# prerendered because public/index.html is one of the compiler's content
# sources. Generated files are excluded by .dockerignore, so merging public/
# here cannot replace the shell output produced above. The document it scans
# differs from the final one only by the commit id in a <meta> and in a
# /b/<sha>/ path prefix, neither of which is a class
# (tests/tailwind-build.test.js holds that).
WORKDIR /build
COPY tailwind.config.js ./
COPY styles ./styles
COPY scripts/build-tailwind.js ./scripts/build-tailwind.js
COPY public ./public
RUN --mount=type=bind,from=asset-deps,source=/build/frontend/node_modules,target=/build/frontend/node_modules,rw \
    node scripts/build-tailwind.js

# Everything from here down belongs to one commit. Write the document this
# build actually serves: the same render, with the id in its <meta> and on
# every asset URL. The release file and the precompressed copies follow it
# because both read that id.
ARG GIT_SHA=dev
ENV GIT_SHA=$GIT_SHA
RUN --mount=type=bind,from=asset-deps,source=/build/frontend/node_modules,target=/build/frontend/node_modules \
    node frontend/scripts/build-shell.mjs --document
COPY scripts/build-shell-release.js ./scripts/build-shell-release.js
RUN node scripts/build-shell-release.js
COPY scripts/precompress-static-assets.js ./scripts/precompress-static-assets.js
RUN node scripts/precompress-static-assets.js

FROM node:22-alpine

# Kubernetes mode talks to the Kubernetes and PostgreSQL APIs over the
# network. It deliberately contains no Docker CLI or container-runtime tools.
RUN apk add --no-cache git postgresql-client

WORKDIR /app
COPY --chown=node:node package.json package-lock.json ./
# The download cache stays out of this layer too (see asset-deps): here it
# would ship in the image every pod pulls, in a directory only root can read.
RUN npm ci --omit=dev --cache /tmp/npm-cache && rm -rf /tmp/npm-cache
# Ship only runtime inputs. In particular, tests, docs, frontend sources and
# both builder dependency trees stay out of the final image. scripts/ includes
# the Kubernetes migration/asset entry points and shell-stamp.js, while
# worker/ remains available for the single-server fallback path.
COPY --chown=node:node server.js dapp.json ./
COPY --chown=node:node src ./src
COPY --chown=node:node scripts ./scripts
COPY --chown=node:node worker ./worker
# The ready-made apps and game starters a new project's repository is written
# from (services/app-templates.js). They sit outside src/ only so that
# check-sql.js leaves their queries alone, so they need their own line.
COPY --chown=node:node app-templates ./app-templates
# Copy the whole generated public tree: it contains the source assets plus the
# prerendered document, every lazy shell chunk, and the compiled stylesheet.
COPY --chown=node:node --from=shell /build/public ./public
COPY --chown=node:node --from=shell /build/public.precompressed ./public.precompressed

# Numeric on purpose: the app's preview and production pods run with
# runAsNonRoot (services/kubernetes.js podSecurityContext) and no runAsUser,
# so Kubernetes verifies non-root from the image's own user, and it can only
# do that for a numeric one. kpack images carry a numeric CNB user; this
# image, built by the rootless BuildKit lane, has to say 1000:1000 itself
# (the node:22-alpine `node` account's UID/GID). `USER node` fails to
# schedule with "image has non-numeric user (node), cannot verify user is
# non-root".
USER 1000:1000
# #2508: this image ran with NODE_ENV UNSET, and a great deal keys off it.
# Two consequences were live in production:
#
#   - express's default error handler writes `err.stack` into the response
#     body unless NODE_ENV is exactly 'production'. With no error-handling
#     middleware anywhere (now added, src/middleware/error-handler.js), a
#     stack trace was one unhandled throw away from any client.
#   - `SECURE_COOKIE` in src/middleware/auth.js is
#     `process.env.NODE_ENV === 'production'`, so session cookies were issued
#     WITHOUT the Secure attribute on a platform served only over HTTPS.
#
# Set on the runtime stage only. The build stages above must keep their dev
# dependencies — `npm ci` treats NODE_ENV=production as `--omit=dev`, which
# would break the shell and Tailwind builds.
ENV NODE_ENV=production
ARG GIT_SHA=dev
ENV GIT_SHA=$GIT_SHA
EXPOSE 3000
CMD ["node", "server.js"]

{
  "version": 1,
  "impact": "ui",
  "rationale": "PR #2688 changes native WebView startup classification so the platform header keeps the simulated status-bar inset.",
  "stories": [
    {
      "id": "native-header-status-bar",
      "claim": "The native header retains its status-bar safe area because startup classifies the document as native without applying the ordinary-browser override.",
      "persona": "member",
      "viewports": [
        { "name": "phone", "width": 390, "height": 844 }
      ],
      "intent": {
        "startPath": "/?demo=1&un-native-webview=1&safe-bottom=1",
        "steps": ["Open Homeroom home using the existing native Android presentation override.", "Inspect the home button and title in the platform header."],
        "checkpoint": "The head revision reserves the status-bar space above the platform header controls.",
        "focus": "Platform header",
        "baseState": "present",
        "animation": "none"
      },
      "replay": {
        "before": {
          "startPath": "/?demo=1&un-native-webview=1&safe-bottom=1",
          "actions": [
            { "id": "wait-header", "stage": "header", "type": "waitFor", "target": { "by": "css", "value": "#platform-header" } }
          ]
        },
        "after": {
          "startPath": "/?demo=1&un-native-webview=1&safe-bottom=1",
          "actions": [
            { "id": "wait-header", "stage": "header", "type": "waitFor", "target": { "by": "css", "value": "#platform-header" } }
          ]
        },
        "checkpoint": {
          "id": "header-inset",
          "label": "Native header keeps the status-bar inset",
          "focus": {
            "before": { "by": "css", "value": "#platform-header" },
            "after": { "by": "css", "value": "#platform-header" }
          },
          "assertions": {
            "before": [
              { "type": "attached", "target": { "by": "css", "value": "html.web-browser-chrome.in-native-webview" } },
              { "type": "visible", "target": { "by": "css", "value": "#platform-header" } }
            ],
            "after": [
              { "type": "attached", "target": { "by": "css", "value": "html.in-native-webview:not(.web-browser-chrome)" } },
              { "type": "visible", "target": { "by": "css", "value": "#platform-header" } }
            ]
          },
          "animation": "none"
        }
      }
    }
  ]
}

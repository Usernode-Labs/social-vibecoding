{
  "version": 1,
  "impact": "ui",
  "rationale": "PR #2548 adds a default-off Global Chat opt-in, hides its Improve entry, and reveals the entry again after an in-page opt-in.",
  "stories": [
    {
      "id": "global-chat-opt-in-setting",
      "claim": "Global Chat settings expose an explicit experimental opt-in that is off by default.",
      "persona": "member",
      "viewports": [
        {
          "name": "desktop",
          "width": 1280,
          "height": 800
        },
        {
          "name": "mobile",
          "width": 390,
          "height": 844
        }
      ],
      "intent": {
        "startPath": "/#settings/global-chat",
        "steps": [
          "Wait for the Global Chat settings section to finish loading."
        ],
        "checkpoint": "The head revision shows an unchecked Enable experimental Global Chat switch.",
        "focus": "Global Chat settings section",
        "baseState": "not_present",
        "animation": "none"
      },
      "replay": {
        "before": {
          "startPath": "/#settings/global-chat",
          "actions": [
            {
              "id": "wait-profile",
              "stage": "loaded",
              "type": "waitFor",
              "text": "Classic is always the startup mode. This profile only controls Global Chat; development sessions keep their separate defaults."
            }
          ]
        },
        "after": {
          "startPath": "/#settings/global-chat",
          "actions": [
            {
              "id": "wait-profile",
              "stage": "loaded",
              "type": "waitFor",
              "text": "Classic is always the startup mode. This profile only controls Global Chat; development sessions keep their separate defaults."
            }
          ]
        },
        "checkpoint": {
          "id": "opt-in-off",
          "label": "Global Chat opt-in appears unchecked",
          "focus": {
            "before": {
              "by": "css",
              "value": "[data-settings-section='global-chat']"
            },
            "after": {
              "by": "css",
              "value": "[data-settings-section='global-chat']"
            }
          },
          "assertions": {
            "before": [
              {
                "type": "detached",
                "target": {
                  "by": "css",
                  "value": "#settings-global-chat-enabled"
                }
              },
              {
                "type": "visible",
                "target": {
                  "by": "css",
                  "value": "[data-settings-section='global-chat']"
                }
              }
            ],
            "after": [
              {
                "type": "visible",
                "target": {
                  "by": "css",
                  "value": "#settings-global-chat-enabled"
                }
              },
              {
                "type": "detached",
                "target": {
                  "by": "css",
                  "value": "#settings-global-chat-enabled:checked"
                }
              },
              {
                "type": "visible",
                "target": {
                  "by": "css",
                  "value": "[data-settings-section='global-chat']"
                }
              }
            ]
          },
          "animation": "none"
        }
      }
    },
    {
      "id": "global-chat-default-off-improve",
      "claim": "With the default-off profile, Improve no longer exposes the experimental New chat entry.",
      "persona": "member",
      "viewports": [
        {
          "name": "desktop",
          "width": 1280,
          "height": 800
        },
        {
          "name": "mobile",
          "width": 390,
          "height": 844
        }
      ],
      "intent": {
        "startPath": "/?shot=improve",
        "steps": [
          "Open Improve."
        ],
        "checkpoint": "The New chat entry appears before the change and is absent after it.",
        "focus": "Improve panel",
        "baseState": "present",
        "animation": "none"
      },
      "replay": {
        "before": {
          "startPath": "/?shot=improve",
          "actions": [
            {
              "id": "wait-improve",
              "stage": "panel",
              "type": "waitFor",
              "target": {
                "by": "css",
                "value": "#improve-panel"
              }
            }
          ]
        },
        "after": {
          "startPath": "/?shot=improve",
          "actions": [
            {
              "id": "wait-improve",
              "stage": "panel",
              "type": "waitFor",
              "target": {
                "by": "css",
                "value": "#improve-panel"
              }
            }
          ]
        },
        "checkpoint": {
          "id": "entry-hidden",
          "label": "Improve hides the experimental entry until opt-in",
          "focus": {
            "before": {
              "by": "css",
              "value": "#improve-panel"
            },
            "after": {
              "by": "css",
              "value": "#improve-panel"
            }
          },
          "assertions": {
            "before": [
              {
                "type": "visible",
                "target": {
                  "by": "css",
                  "value": "#global-chat-new-chat-btn"
                }
              }
            ],
            "after": [
              {
                "type": "detached",
                "target": {
                  "by": "css",
                  "value": "#global-chat-new-chat-btn"
                }
              }
            ]
          },
          "animation": "none"
        }
      }
    },
    {
      "id": "global-chat-enabled-improve-entry",
      "claim": "Enabling the Settings opt-in reveals the existing experimental New chat entry in Improve without a page reload.",
      "persona": "member",
      "viewports": [
        {
          "name": "desktop",
          "width": 1280,
          "height": 800
        },
        {
          "name": "mobile",
          "width": 390,
          "height": 844
        }
      ],
      "intent": {
        "startPath": "/#settings/global-chat",
        "steps": [
          "Turn on “Enable experimental Global Chat” and wait for the enabled confirmation.",
          "Navigate to the Homeroom app.",
          "Open Improve."
        ],
        "checkpoint": "After enabling Global Chat, the New chat entry appears in Improve in the same page.",
        "focus": "Improve panel",
        "baseState": "present",
        "animation": "steps"
      },
      "replay": {
        "before": {
          "startPath": "/#settings/global-chat",
          "actions": [
            {
              "id": "wait-profile",
              "stage": "settings",
              "type": "waitFor",
              "text": "Classic is always the startup mode. This profile only controls Global Chat; development sessions keep their separate defaults."
            },
            {
              "id": "open-switcher",
              "stage": "switcher",
              "type": "click",
              "target": {
                "by": "css",
                "value": "#app-switcher-btn"
              }
            },
            {
              "id": "open-home",
              "stage": "home",
              "type": "click",
              "target": {
                "by": "css",
                "value": "#switcher-row-home"
              }
            },
            {
              "id": "wait-improve-button",
              "stage": "home-ready",
              "type": "waitFor",
              "target": {
                "by": "css",
                "value": "#improve-btn"
              }
            },
            {
              "id": "open-improve",
              "stage": "improve",
              "type": "click",
              "target": {
                "by": "css",
                "value": "#improve-btn"
              }
            },
            {
              "id": "wait-new-chat",
              "stage": "new-chat",
              "type": "waitFor",
              "target": {
                "by": "css",
                "value": "#global-chat-new-chat-btn"
              }
            }
          ]
        },
        "after": {
          "startPath": "/#settings/global-chat",
          "actions": [
            {
              "id": "wait-profile",
              "stage": "settings",
              "type": "waitFor",
              "text": "Classic is always the startup mode. This profile only controls Global Chat; development sessions keep their separate defaults."
            },
            {
              "id": "enable-global-chat",
              "stage": "enabled",
              "type": "check",
              "target": {
                "by": "css",
                "value": "#settings-global-chat-enabled"
              }
            },
            {
              "id": "wait-enabled",
              "stage": "confirmed",
              "type": "waitFor",
              "target": {
                "by": "css",
                "value": "#settings-global-chat-enabled:checked"
              }
            },
            {
              "id": "wait-save",
              "stage": "saved",
              "type": "waitFor",
              "quietNetwork": true
            },
            {
              "id": "open-switcher",
              "stage": "switcher",
              "type": "click",
              "target": {
                "by": "css",
                "value": "#app-switcher-btn"
              }
            },
            {
              "id": "open-home",
              "stage": "home",
              "type": "click",
              "target": {
                "by": "css",
                "value": "#switcher-row-home"
              }
            },
            {
              "id": "wait-improve-button",
              "stage": "home-ready",
              "type": "waitFor",
              "target": {
                "by": "css",
                "value": "#improve-btn"
              }
            },
            {
              "id": "open-improve",
              "stage": "improve",
              "type": "click",
              "target": {
                "by": "css",
                "value": "#improve-btn"
              }
            },
            {
              "id": "wait-new-chat",
              "stage": "new-chat",
              "type": "waitFor",
              "target": {
                "by": "css",
                "value": "#global-chat-new-chat-btn"
              }
            }
          ]
        },
        "checkpoint": {
          "id": "enabled-entry",
          "label": "Enabling Global Chat reveals New chat",
          "focus": {
            "before": {
              "by": "css",
              "value": "#improve-panel"
            },
            "after": {
              "by": "css",
              "value": "#improve-panel"
            }
          },
          "assertions": {
            "before": [
              {
                "type": "url",
                "path": "/"
              },
              {
                "type": "visible",
                "target": {
                  "by": "css",
                  "value": "#global-chat-new-chat-btn"
                }
              }
            ],
            "after": [
              {
                "type": "url",
                "path": "/"
              },
              {
                "type": "visible",
                "target": {
                  "by": "css",
                  "value": "#global-chat-new-chat-btn"
                }
              },
              {
                "type": "checked",
                "target": {
                  "by": "css",
                  "value": "#settings-global-chat-enabled"
                }
              }
            ]
          },
          "animation": "steps"
        }
      }
    }
  ]
}

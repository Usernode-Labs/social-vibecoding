{
  "version": 1,
  "impact": "ui",
  "rationale": "PR #2548 adds a default-off Global Chat opt-in and hides its Improve entry until a member enables it.",
  "stories": [
    {
      "id": "global-chat-opt-in",
      "claim": "Global Chat settings expose an explicit experimental opt-in that is off by default.",
      "persona": "member",
      "viewports": [
        { "name": "desktop", "width": 1280, "height": 800 }
      ],
      "intent": {
        "startPath": "/#settings/global-chat",
        "steps": ["Open Global Chat settings and wait for the member profile to load."],
        "checkpoint": "The head revision shows an unchecked Enable experimental Global Chat switch.",
        "focus": "Global Chat settings section",
        "baseState": "present",
        "animation": "steps"
      },
      "replay": {
        "before": {
          "startPath": "/#settings/global-chat",
          "actions": [
            { "id": "wait-profile", "stage": "loaded", "type": "waitFor", "text": "Classic is always the startup mode. This profile only controls Global Chat; development sessions keep their separate defaults." }
          ]
        },
        "after": {
          "startPath": "/#settings/global-chat",
          "actions": [
            { "id": "wait-profile", "stage": "loaded", "type": "waitFor", "text": "Classic is always the startup mode. This profile only controls Global Chat; development sessions keep their separate defaults." }
          ]
        },
        "checkpoint": {
          "id": "opt-in-off",
          "label": "Global Chat opt-in appears unchecked",
          "focus": {
            "before": { "by": "css", "value": "[data-settings-section='global-chat']" },
            "after": { "by": "css", "value": "[data-settings-section='global-chat']" }
          },
          "assertions": {
            "before": [
              { "type": "detached", "target": { "by": "css", "value": "#settings-global-chat-enabled" } },
              { "type": "visible", "target": { "by": "css", "value": "[data-settings-section='global-chat']" } }
            ],
            "after": [
              { "type": "visible", "target": { "by": "css", "value": "#settings-global-chat-enabled" } },
              { "type": "detached", "target": { "by": "css", "value": "#settings-global-chat-enabled:checked" } },
              { "type": "visible", "target": { "by": "css", "value": "[data-settings-section='global-chat']" } }
            ]
          },
          "animation": "steps"
        }
      }
    },
    {
      "id": "global-chat-improve-entry",
      "claim": "With the default-off profile, Improve no longer exposes the experimental New chat entry.",
      "persona": "member",
      "viewports": [
        { "name": "desktop", "width": 1280, "height": 800 }
      ],
      "intent": {
        "startPath": "/?shot=improve",
        "steps": ["Open Improve with the member's default Global Chat profile."],
        "checkpoint": "The New chat entry appears before the change and is absent after it.",
        "focus": "Improve panel",
        "baseState": "present",
        "animation": "steps"
      },
      "replay": {
        "before": {
          "startPath": "/?shot=improve",
          "actions": [
            { "id": "wait-improve", "stage": "panel", "type": "waitFor", "target": { "by": "css", "value": "#improve-panel" } }
          ]
        },
        "after": {
          "startPath": "/?shot=improve",
          "actions": [
            { "id": "wait-improve", "stage": "panel", "type": "waitFor", "target": { "by": "css", "value": "#improve-panel" } }
          ]
        },
        "checkpoint": {
          "id": "entry-hidden",
          "label": "Improve hides the experimental entry until opt-in",
          "focus": {
            "before": { "by": "css", "value": "#improve-panel" },
            "after": { "by": "css", "value": "#improve-panel" }
          },
          "assertions": {
            "before": [
              { "type": "visible", "target": { "by": "css", "value": "#global-chat-new-chat-btn" } }
            ],
            "after": [
              { "type": "detached", "target": { "by": "css", "value": "#global-chat-new-chat-btn" } }
            ]
          },
          "animation": "steps"
        }
      }
    }
  ]
}

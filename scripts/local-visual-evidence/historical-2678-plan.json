{
  "version": 1,
  "impact": "ui",
  "rationale": "PR #2678 hides the season picker and card for a member without previous-season participation.",
  "stories": [
    {
      "id": "new-member-season-picker",
      "claim": "A new member sees the current standings without a season picker above them.",
      "persona": "member",
      "viewports": [
        { "name": "desktop", "width": 1280, "height": 800 }
      ],
      "intent": {
        "startPath": "/#leaderboard/topochain",
        "steps": ["Open the Topochain Leaderboard as the capture member and wait for standings to load."],
        "checkpoint": "The base revision shows the season picker; the head revision omits it for this new member.",
        "focus": "Leaderboard standings and event bar",
        "baseState": "present",
        "animation": "steps"
      },
      "replay": {
        "before": {
          "startPath": "/#leaderboard/topochain",
          "actions": [
            { "id": "wait-standings", "stage": "loaded", "type": "waitFor", "target": { "by": "css", "value": "#tc-lb-body :is(table, [data-tc-lb-empty])" } }
          ]
        },
        "after": {
          "startPath": "/#leaderboard/topochain",
          "actions": [
            { "id": "wait-standings", "stage": "loaded", "type": "waitFor", "target": { "by": "css", "value": "#tc-lb-body :is(table, [data-tc-lb-empty])" } }
          ]
        },
        "checkpoint": {
          "id": "history-gate",
          "label": "Season picker is hidden for a new member",
          "focus": {
            "before": { "by": "css", "value": "#leaderboard-screen" },
            "after": { "by": "css", "value": "#leaderboard-screen" }
          },
          "assertions": {
            "before": [
              { "type": "visible", "target": { "by": "css", "value": "#tc-ev-select" } },
              { "type": "visible", "target": { "by": "css", "value": "#tc-lb-body" } }
            ],
            "after": [
              { "type": "detached", "target": { "by": "css", "value": "#tc-ev-select" } },
              { "type": "visible", "target": { "by": "css", "value": "#tc-lb-body" } }
            ]
          },
          "animation": "steps"
        }
      }
    }
  ]
}

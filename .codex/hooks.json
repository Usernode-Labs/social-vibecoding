{
  "description": "Run the warning-first interface-law scan after governed source edits.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^(?:apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/frontend/scripts/post-edit-interface-laws.mjs\"",
            "timeout": 10,
            "statusMessage": "Reviewing interface laws"
          }
        ]
      }
    ]
  }
}

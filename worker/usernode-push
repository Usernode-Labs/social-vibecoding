#!/bin/sh
# Push the current dev branch to GitHub by asking the platform to do it.
#
# The worker container carries no GitHub credentials. This script is
# the only path by which the worker can affect anything outside its
# own filesystem: it POSTs to the platform's internal API, which
# validates the session, looks up the canonical branch name from the
# DB, and queues a conductor-owned push. The conductor exports Git objects
# from this container and authenticates only in its fresh trusted repository.
#
# The endpoint contract: POST /api/internal/sessions/$SESSION_ID/push
# with `Authorization: Bearer $WORKER_JWT`. No body fields — the
# branch is determined platform-side, not by us.
#
# Exit code mirrors push success so the caller (run-cc.sh) can carry
# on the existing PUSH_OK accounting. We deliberately keep this script
# tiny + stdout/stderr-only — anything fancier risks drifting from
# run-cc.sh's __USERNODE_* marker parsing.

set -u

# Defense-in-depth: scout is meant to be read-only, and run-cc.sh
# already skips the commit/push block when MODE=scout. But CC could
# theoretically invoke this script directly via Bash — refuse outright
# so a runaway scout turn cannot push to the session branch even if it
# tries. The `WORKER_JWT` env is also dropped from scout's docker exec
# (see worker.execInWorker), so the auth check below would fail anyway,
# but a clear error here beats `WORKER_JWT required` as the surfaced
# message.
if [ "${MODE:-build}" = "scout" ]; then
  echo "__USERNODE_WARN__ usernode-push: refusing to push from scout mode" >&2
  exit 2
fi

: "${WORKER_JWT:?WORKER_JWT required}"
: "${SESSION_ID:?SESSION_ID required}"
: "${PLATFORM_URL:=http://usernode:3000}"

URL="${PLATFORM_URL%/}/api/internal/sessions/${SESSION_ID}/push"

# A push can land while the platform is restarting (releases restart it
# dozens of times a day): the old server is draining and the new one is not
# up yet, so a single try failed and the turn ended with its commit unpushed
# (push_ok=0). Every attempt asks the platform to push the same branch,
# which is idempotent, so it is tried again after a pause when curl itself
# fails (connection refused, DNS, timeout), when the platform answers 5xx or
# 429, and never on any other answer, nor on a failure the platform marks
# permanent. The pauses, in seconds, between six tries come to about two
# minutes; USERNODE_PUSH_BACKOFF overrides them (tests).
#
# The retry is opt-in. The platform sets USERNODE_PUSH_RETRY=1 on every turn
# it runs in a worker (worker.js, the per-turn env), so a real push rides out
# a restart. Anything else that runs this script, such as a test whose
# platform is never there or a branch's own copy of a runner suite, tries
# once, as before the retry existed, unless it names its own pauses.
if [ "${USERNODE_PUSH_RETRY:-}" = "1" ]; then
  DEFAULT_BACKOFF="5 10 20 30 45"
else
  DEFAULT_BACKOFF=""
fi
BACKOFF="${USERNODE_PUSH_BACKOFF:-$DEFAULT_BACKOFF}"

attempt=1
for pause in $BACKOFF ""; do
  # `-w "\n%{http_code}"` appends the HTTP code on its own line so we
  # can split body from status without juggling temp files. `-sS` keeps
  # the output clean while still showing errors.
  if RESP=$(curl -sS -X POST \
    -H "Authorization: Bearer $WORKER_JWT" \
    -H "Content-Type: application/json" \
    -d '{}' \
    -w "\n%{http_code}" \
    --max-time 90 \
    "$URL" 2>&1); then
    CODE=$(printf '%s' "$RESP" | tail -n1)
    BODY=$(printf '%s' "$RESP" | sed '$d')
    if [ "$CODE" = "200" ]; then
      # Echo the sha + branch the platform pushed for easier debugging in
      # the host's stream-json parser. Keep this short; run-cc.sh will
      # post its own __USERNODE_RESULT__ summary with the SHA from
      # `git rev-parse HEAD` immediately after.
      echo "usernode-push: ok ($BODY)"
      exit 0
    fi
    FAILED="HTTP $CODE: $BODY"
    case "$CODE" in
      5??|429|000) RETRY=1 ;;
      *) RETRY=0 ;;
    esac
    case "$BODY" in
      *'"permanent":true'*) RETRY=0 ;;
    esac
  else
    # curl-level failure (DNS, connect, timeout). Don't expose the JWT
    # in error output; curl shouldn't echo it but be defensive.
    FAILED="curl failed: $(echo "$RESP" | sed 's/Bearer [^ ]*/Bearer ***/g' | tr '\n' ' ')"
    RETRY=1
  fi
  if [ "$RETRY" != "1" ] || [ -z "$pause" ]; then
    break
  fi
  echo "usernode-push: try $attempt failed ($FAILED); trying again in ${pause}s" >&2
  sleep "$pause"
  attempt=$((attempt + 1))
done

echo "__USERNODE_WARN__ usernode-push: $FAILED"
exit 1

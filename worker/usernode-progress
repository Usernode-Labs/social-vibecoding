#!/bin/sh
# usernode-progress "Adding the tier rows" (#4387): what a first version's
# build is adding now, for the people waiting on it. The build prompt asks
# the agent to run it as it starts each point of the approved plan, with a
# short phrase that starts with "Adding", chained in front of the next
# command it runs anyway (`usernode-progress "Adding …" && npm run build`),
# so a note is never a model call of its own. Nothing is sent from here: the
# platform reads the phrase off the command in the turn's own stream
# (services/first-version-screens.js captionOf), cleans it and shows it as
# the App tab's build line note ("Building it · Adding the tier rows").
#
# It answers with the time, so the build need not spend a step reading the
# clock (homeroom-bot-live.js clockLines).
#
# Exit 0 always: a note never fails a build, and never stops the command
# chained after it.
phrase="$*"
now=$(date -u +%H:%M 2>/dev/null || true)
if [ -z "$phrase" ]; then
  echo 'usage: usernode-progress "Adding <what>" (at most 40 characters)'
  exit 0
fi
echo "Noted: $phrase${now:+ (it is $now UTC)}"
exit 0

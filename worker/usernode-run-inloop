#!/usr/bin/env node
'use strict';

// Start an app inside a build worker with the same manifest-committed fallback
// values staging uses. No stored production secret is available here. An app
// with a required value and no local fallback reports that gap explicitly.
//
// The launch also reproduces the two things production puts between a
// browser and an app, so the agent looks at what users will get rather than
// at a sandbox-only version of it:
//
//   1. THE BUILD. Every production and staging image runs the app's
//      `npm run build` (the scaffold's Dockerfile builder stage, kpack's
//      BP_NODE_RUN_SCRIPTS=build). That is what writes public/tailwind.css.
//      A plain `node server.js` has no such file, so the page an agent
//      checked used to be unstyled here, and "fixing" the missing file was
//      how an app once shipped `/tailwind.css → 204` and blanked production
//      for two days (Sheep countrr #38).
//   2. THE EDGE. In production the Ingress routes `/usernode-bridge/`,
//      `/usernode-native/` and `/usernode-tailwind/` to the platform before
//      the app ever sees them (kubernetes.js PLATFORM_ASSET_PREFIXES). Here a
//      small front proxy on $INLOOP_PORT does the same — like the shots
//      browser's worker/shots-origin-proxy.js — and passes everything else,
//      WebSocket upgrades included, to the app on an internal port. Without
//      it those requests reached the app, came back 401, and agents patched
//      the app to silence an error that production never has.
//
// The platform's own repository serves its own copies of those three trees
// (its Ingress deliberately does not route them), so a checkout that carries
// public/usernode-bridge/ gets them from the app, as it does in production.
//
// ONE LAUNCH PER PORT (App bench run 190, 13 Oct 2026). Five of six builds
// relaunched their app after an edit, found the port still held by the launch
// before ("cannot listen on 3100"), and wrote loops over /proc to kill it.
// So each launch records itself (LAUNCH_DIR/<port>.json: this process and
// the app it started), a new launch on the same port stops the one recorded
// there first, and `usernode-run-inloop --stop` stops it on its own: run it
// before a build's final message, or the server goes on holding the turn
// open. Only a launch this command recorded is stopped, and only while it is
// still this command (its command line says so).

// SIGNED IN (App bench run 191, 14 Oct 2026). An app behind the platform's
// identity token verifies it with USERNODE_JWT_PUBLIC_KEY, which a worker
// does not have, so every page this launch served answered a visitor who was
// signed out, and 11 of 17 builds read the platform's check script to learn
// to mint a token of their own. So, for an app (not the platform's own
// repository) whose worker environment sets no such key, the launch hands the
// app the public half of a key pair of its own as the platform would, with
// USERNODE_APP_ID, and prints a link that opens the app signed in as the
// checks' viewer; `usernode-run-inloop --link [route]` prints one for any
// route, and usernode-run-checks signs its checks in with it. The pair is made
// once (LAUNCH_DIR/identity.json, readable by this user alone) so a relaunch
// keeps earlier links working. Nothing but this local launch trusts it.

const crypto = require('crypto');
const fs = require('fs');
const http = require('http');
const https = require('https');
const net = require('net');
const path = require('path');
const { spawn, spawnSync } = require('child_process');
const { readProcess, sameProcess, processTree, processGroup, stopOwned } = require('./process-ownership');

const ENV_KEY = /^[A-Z][A-Z0-9_]*$/;
const LAUNCH_KEYS = new Set(['DATABASE_URL', 'USERNODE_ENV', 'PORT']);
const WORKER_ONLY_KEYS = [
  'OPENROUTER_API_KEY', 'WORKER_JWT', 'HOMEROOM_MCP_TOKEN',
  'ISSUES_JWT', 'PROD_DEBUG_JWT', 'SHOTS_JWT',
];

const PLATFORM_ASSET_PREFIXES = Object.freeze(['/usernode-bridge/', '/usernode-native/', '/usernode-tailwind/']);
// Same allowlists as the shots proxy: an asset request carries none of the
// page's cookies or credentials to the platform, and brings back only what a
// browser needs to cache and render it.
const FORWARDED_ASSET_HEADERS = Object.freeze(['accept', 'accept-encoding', 'if-none-match', 'if-modified-since', 'user-agent']);
const RETURNED_ASSET_HEADERS = Object.freeze(['content-type', 'content-length', 'content-encoding', 'cache-control', 'etag', 'last-modified']);
const BUILD_TIMEOUT_MS = 5 * 60 * 1000;
// Where each launch records itself, how long an earlier one is given to stop
// after SIGTERM, and how often it is looked at meanwhile.
const LAUNCH_DIR = '/tmp/usernode-inloop';
const STOP_WAIT_MS = 5000;

// The viewer the platform's check script signs in as (usernode-bench-capture.js
// VIEWER), and the app id a local launch uses when the worker names none.
const VIEWER = Object.freeze({ id: 900001, username: 'staging-demo-viewer' });
const LOCAL_APP_ID = '1';
const IDENTITY_FILE = 'identity.json';
const LINK_TTL_S = 8 * 60 * 60;

function base64url(input) {
  return Buffer.from(input).toString('base64').replace(/=+$/, '').replace(/\+/g, '-').replace(/\//g, '_');
}

/**
 * This worker's local identity (see SIGNED IN): the key pair kept in `dir`,
 * made the first time. Returns { publicKeyPem, privateKeyPem } or null when
 * it can be neither read nor made.
 */
function localIdentity({ dir = LAUNCH_DIR, fsImpl = fs } = {}) {
  const file = path.join(dir, IDENTITY_FILE);
  try {
    const kept = JSON.parse(fsImpl.readFileSync(file, 'utf8'));
    if (kept && typeof kept.publicKeyPem === 'string' && typeof kept.privateKeyPem === 'string') return kept;
  } catch { /* made below */ }
  try {
    const { publicKey, privateKey } = crypto.generateKeyPairSync('rsa', { modulusLength: 2048 });
    const made = {
      publicKeyPem: publicKey.export({ type: 'spki', format: 'pem' }).toString(),
      privateKeyPem: privateKey.export({ type: 'pkcs8', format: 'pem' }).toString(),
    };
    fsImpl.mkdirSync(dir, { recursive: true, mode: 0o700 });
    // Written whole or not at all: a launch beside this one reads either the
    // old file or the new.
    const tmp = `${file}.${process.pid}.tmp`;
    fsImpl.writeFileSync(tmp, JSON.stringify(made), { mode: 0o600 });
    fsImpl.renameSync(tmp, file);
    return made;
  } catch {
    return null;
  }
}

/**
 * The viewer's identity token for app `appId`, signed with `identity`: the
 * shape services/platform-jwt.js signs (RS256, issuer `usernode`, audience
 * `usernode:app:<id>`, `pur: 'iframe'`). Pure apart from the signature.
 */
function viewerToken(identity, appId, { now = Date.now(), ttlSeconds = LINK_TTL_S } = {}) {
  const iat = Math.floor(now / 1000);
  const header = { alg: 'RS256', typ: 'JWT' };
  const payload = {
    id: VIEWER.id, username: VIEWER.username, usernode_pubkey: null, locale: null, pur: 'iframe',
    iat, exp: iat + ttlSeconds, aud: `usernode:app:${appId}`, iss: 'usernode',
  };
  const signingInput = `${base64url(JSON.stringify(header))}.${base64url(JSON.stringify(payload))}`;
  const signature = crypto.sign('RSA-SHA256', Buffer.from(signingInput), identity.privateKeyPem);
  return `${signingInput}.${base64url(signature)}`;
}

/**
 * A signed-in link to `route` on the launch at `port`, the token added to its
 * query (a hash route keeps its hash). `localhost`, as the platform's check
 * script browses: the bridge reads a dotted host as the app's own public
 * domain and pins a mark no screen inside Homeroom shows. Pure apart from the
 * signature.
 */
function signedInLink(identity, appId, port, route = '/', opts = {}) {
  const url = new URL(String(route || '/').startsWith('/') ? route : `/${route}`, `http://localhost:${Number(port)}/`);
  url.searchParams.set('token', viewerToken(identity, appId, opts));
  return url.toString();
}

/**
 * Whether this launch signs its app in (see SIGNED IN): an app's checkout
 * (routeAssets: not the platform's own) whose worker environment carries no
 * identity key of its own. Pure.
 */
function signsIn(env, routeAssets) {
  return routeAssets === true && !String(env.USERNODE_JWT_PUBLIC_KEY || '').trim()
    && String(env.INLOOP_SIGN_IN || '').trim() !== '0';
}

function environmentForInLoop(manifest, workerEnv) {
  if (workerEnv.INLOOP_BROWSER !== '1' || workerEnv.INLOOP_ENV !== 'staging'
    || !workerEnv.INLOOP_PORT || !workerEnv.INLOOP_DATABASE_URL) {
    throw new Error('this command requires a build turn with INLOOP_* values');
  }
  const env = { ...workerEnv,
    USERNODE_ENV: workerEnv.INLOOP_ENV,
    PORT: workerEnv.INLOOP_PORT,
    DATABASE_URL: workerEnv.INLOOP_DATABASE_URL,
  };
  for (const key of WORKER_ONLY_KEYS) delete env[key];
  const missing = [];
  const secrets = Array.isArray(manifest?.secrets) ? manifest.secrets : [];
  for (const secret of secrets) {
    if (!secret || !ENV_KEY.test(secret.key || '') || LAUNCH_KEYS.has(secret.key)) continue;
    // Worker env must never become a source of app secrets. Match staging's
    // private fallback precedence; non-private stored values are unavailable
    // locally, so use only their manifest default or report the missing key.
    delete env[secret.key];
    const isPrivate = !!(secret.private || secret.sensitive);
    const stagingDefault = isPrivate && typeof secret.staging_default === 'string'
      ? secret.staging_default : null;
    const fallback = stagingDefault != null ? stagingDefault
      : (typeof secret.default === 'string' ? secret.default : null);
    if (fallback != null) env[secret.key] = fallback;
    else if (secret.required) missing.push(secret.key);
  }
  if (missing.length) {
    throw new Error(`local staging launch needs committed fallbacks for: ${missing.join(', ')}`);
  }
  return env;
}

function readJson(filePath) {
  try {
    return JSON.parse(fs.readFileSync(filePath, 'utf8'));
  } catch (err) {
    if (err.code === 'ENOENT') return {};
    throw err;
  }
}

const readManifest = readJson;

// The build production runs, when the app declares one. INLOOP_SKIP_BUILD=1
// is the deliberate escape hatch (a quick re-launch after a server-only
// edit); it is never the default because an unbuilt app is exactly the
// sandbox-only page this launch exists to stop agents from looking at.
function shouldRunBuild(pkg, env) {
  if (String(env.INLOOP_SKIP_BUILD || '').trim() === '1') return false;
  const script = pkg && pkg.scripts && pkg.scripts.build;
  return typeof script === 'string' && script.trim() !== '';
}

// True when this checkout ships the hosted asset trees itself — the
// platform's own repository. Apps may not vendor them, so for every other
// app the platform answers these paths, here as in production.
// INLOOP_PLATFORM_ASSETS=1/0 overrides the detection.
function routesPlatformAssets(dir, env) {
  const forced = String(env.INLOOP_PLATFORM_ASSETS || '').trim();
  if (forced === '1') return true;
  if (forced === '0') return false;
  return !fs.existsSync(path.join(dir, 'public', 'usernode-bridge'));
}

function platformAssetOrigin(env) {
  try {
    const url = new URL(String(env.PLATFORM_URL || ''));
    return ['http:', 'https:'].includes(url.protocol) ? url.origin : null;
  } catch { return null; }
}

function isPlatformAssetPath(pathname) {
  if (!PLATFORM_ASSET_PREFIXES.some((prefix) => pathname.startsWith(prefix))) return false;
  let decoded;
  try { decoded = decodeURIComponent(pathname); } catch { return false; }
  return !decoded.split('/').includes('..') && !decoded.includes('\\') && !decoded.includes('\0');
}

function plainReply(res, status, text) {
  if (res.headersSent) { res.destroy(); return; }
  res.writeHead(status, { 'content-type': 'text/plain; charset=utf-8', connection: 'close' });
  res.end(`${text}\n`);
}

function forwardPlatformAsset(req, res, target, assetOrigin) {
  if (!assetOrigin) {
    return plainReply(res, 502, 'usernode-run-inloop: PLATFORM_URL is not set, so the platform-hosted '
      + `asset ${target.pathname} cannot be fetched here. In production the platform serves it.`);
  }
  const headers = {};
  for (const name of FORWARDED_ASSET_HEADERS) if (req.headers[name]) headers[name] = req.headers[name];
  const source = new URL(`${target.pathname}${target.search}`, assetOrigin);
  const transport = source.protocol === 'https:' ? https : http;
  const upstream = transport.request(source, { method: req.method, headers }, (assetResponse) => {
    const returned = {};
    for (const name of RETURNED_ASSET_HEADERS) {
      if (assetResponse.headers[name] != null) returned[name] = assetResponse.headers[name];
    }
    res.writeHead(assetResponse.statusCode || 502, returned);
    assetResponse.pipe(res);
  });
  upstream.on('error', (err) => plainReply(res, 502,
    `usernode-run-inloop: the platform did not answer ${target.pathname} (${err.code || err.message}).`));
  upstream.end();
}

function forwardToApp(req, res, appPort) {
  const upstream = http.request({
    host: '127.0.0.1', port: appPort, method: req.method, path: req.url, headers: req.headers,
  }, (appResponse) => {
    res.writeHead(appResponse.statusCode || 502, appResponse.statusMessage, appResponse.headers);
    appResponse.pipe(res);
  });
  upstream.on('error', (err) => plainReply(res, 502, err.code === 'ECONNREFUSED'
    ? 'usernode-run-inloop: the app is not listening yet (or it exited) — check its output above.'
    : `usernode-run-inloop: the app did not answer (${err.code || err.message}).`));
  req.pipe(upstream);
}

// A WebSocket (or any other) upgrade goes to the app unchanged: re-send the
// request head the proxy already parsed, then splice the two sockets.
function forwardUpgrade(req, socket, head, appPort) {
  const upstream = net.connect(appPort, '127.0.0.1', () => {
    const lines = [`${req.method} ${req.url} HTTP/${req.httpVersion}`];
    for (let i = 0; i < req.rawHeaders.length; i += 2) {
      lines.push(`${req.rawHeaders[i]}: ${req.rawHeaders[i + 1]}`);
    }
    upstream.write(`${lines.join('\r\n')}\r\n\r\n`);
    if (head && head.length) upstream.write(head);
    upstream.pipe(socket);
    socket.pipe(upstream);
  });
  // Either side ending ends the other: a spliced socket left half-open would
  // hold the app (and this launcher) open after the browser has gone.
  upstream.on('error', () => socket.destroy());
  socket.on('error', () => upstream.destroy());
  upstream.on('close', () => socket.destroy());
  socket.on('close', () => upstream.destroy());
}

// The production edge in miniature: platform assets to the platform (when
// routeAssets), everything else to the app.
function createFrontProxy({ appPort, assetOrigin, routeAssets }) {
  const server = http.createServer((req, res) => {
    let target;
    try { target = new URL(req.url || '/', 'http://inloop.invalid'); }
    catch { return plainReply(res, 400, 'usernode-run-inloop: bad request URL'); }
    if (routeAssets && (req.method === 'GET' || req.method === 'HEAD')
      && isPlatformAssetPath(target.pathname)) {
      return forwardPlatformAsset(req, res, target, assetOrigin);
    }
    return forwardToApp(req, res, appPort);
  });
  server.on('upgrade', (req, socket, head) => forwardUpgrade(req, socket, head, appPort));
  return server;
}

function freePort() {
  return new Promise((resolve, reject) => {
    const probe = net.createServer();
    probe.unref();
    probe.on('error', reject);
    probe.listen(0, '127.0.0.1', () => {
      const { port } = probe.address();
      probe.close(() => resolve(port));
    });
  });
}

// Untracked, not-ignored paths, or null outside a git checkout.
function untrackedFiles(dir) {
  const out = spawnSync('git', ['ls-files', '--others', '--exclude-standard', '-z'], { cwd: dir, encoding: 'utf8' });
  if (out.status !== 0 || typeof out.stdout !== 'string') return null;
  return new Set(out.stdout.split('\0').filter(Boolean));
}

// Whatever the build wrote that the app does not already ignore is build
// OUTPUT: the image regenerates it, and the turn's `git add -A` must not
// commit it. Listed in the checkout's local exclude file (never pushed), and
// named, so the agent knows.
function excludeBuildOutputs(dir, before) {
  const after = untrackedFiles(dir);
  if (!before || !after) return [];
  const created = [...after].filter((f) => !before.has(f)).sort();
  if (!created.length) return [];
  try {
    const excludeFile = path.join(dir, '.git', 'info', 'exclude');
    fs.mkdirSync(path.dirname(excludeFile), { recursive: true });
    const lines = created.map((f) => `/${f.replace(/([\\*?[\]!#])/g, '\\$1')}`);
    fs.appendFileSync(excludeFile, `# build outputs written by usernode-run-inloop\n${lines.join('\n')}\n`);
    process.stderr.write(`usernode-run-inloop: the build wrote ${created.length} file(s) the app does not `
      + `ignore (${created.slice(0, 5).join(', ')}${created.length > 5 ? ', …' : ''}); they are kept out `
      + 'of this turn\'s commit because the image builds them itself.\n');
  } catch (err) {
    process.stderr.write(`usernode-run-inloop: could not exclude build outputs: ${err.message}\n`);
  }
  return created;
}

function runBuild(env, dir) {
  process.stderr.write('usernode-run-inloop: running `npm run build`, as the production image does…\n');
  const before = untrackedFiles(dir);
  const result = spawnSync('npm', ['run', 'build'], { env, stdio: 'inherit', timeout: BUILD_TIMEOUT_MS });
  if (result.error) return { ok: false, reason: result.error.message };
  if (result.status !== 0) return { ok: false, reason: `exit ${result.status == null ? result.signal : result.status}` };
  excludeBuildOutputs(dir, before);
  return { ok: true };
}

function launchFile(port, dir = LAUNCH_DIR) {
  return path.join(dir, `${Number(port)}.json`);
}

/** The launch recorded on `port`, or null. Never throws. */
function readLaunch(port, { dir = LAUNCH_DIR, fsImpl = fs } = {}) {
  try {
    const rec = JSON.parse(fsImpl.readFileSync(launchFile(port, dir), 'utf8'));
    return rec && Number.isInteger(rec.pid) && rec.pid > 1 ? rec : null;
  } catch {
    return null;
  }
}

function recordLaunch(port, rec, { dir = LAUNCH_DIR, fsImpl = fs } = {}) {
  try {
    fsImpl.mkdirSync(dir, { recursive: true, mode: 0o700 });
    const target = launchFile(port, dir);
    const temp = `${target}.${process.pid}.tmp`;
    fsImpl.writeFileSync(temp, JSON.stringify(rec), { mode: 0o600 });
    fsImpl.renameSync(temp, target);
  } catch { /* an unrecorded launch is only one --stop cannot find */ }
}

function forgetLaunch(port, pid, { dir = LAUNCH_DIR, fsImpl = fs } = {}) {
  try {
    if (readLaunch(port, { dir, fsImpl })?.pid === pid) fsImpl.unlinkSync(launchFile(port, dir));
  } catch { /* already gone */ }
}

/** Stop only the recorded processes, with identity checks before every signal. */
async function stopLaunch(port, {
  dir = LAUNCH_DIR, fsImpl = fs, kill = process.kill.bind(process), waitMs = STOP_WAIT_MS,
  read = readProcess, tree = processTree, selfPid = process.pid,
} = {}) {
  try {
    const rec = readLaunch(port, { dir, fsImpl });
    if (!rec || rec.pid === selfPid) return false;
    const owned = [rec.launcher, rec.child].filter((p) => p && p.pid !== selfPid
      && p.uid === process.getuid() && sameProcess(p, read(p.pid)));
    // Snapshot descendants BEFORE stopping their parents (npm/shell wrappers
    // otherwise orphan their servers). Never signal an entire process group.
    const records = new Map();
    for (const p of owned) for (const child of tree(p)) {
      if (child.pid !== selfPid) records.set(child.pid, child);
    }
    for (const p of owned) records.set(p.pid, p);
    for (const p of processGroup(rec.child)) if (p.pid !== selfPid) records.set(p.pid, p);
    const stopped = await stopOwned([...records.values()].reverse(), { waitMs, read, kill });
    forgetLaunch(port, rec.pid, { dir, fsImpl });
    return stopped > 0;
  } catch { return false; }
}

async function main() {
  const command = process.argv[2];
  if (command === '--stop') {
    const port = Number(process.env.INLOOP_PORT);
    if (!Number.isInteger(port) || port <= 0) {
      process.stderr.write('usernode-run-inloop: --stop needs a build turn with INLOOP_PORT\n');
      process.exitCode = 2;
      return;
    }
    const stopped = await stopLaunch(port);
    process.stderr.write(stopped
      ? `usernode-run-inloop: stopped the app it launched on ${port}.\n`
      : `usernode-run-inloop: no app it launched is running on ${port}.\n`);
    return;
  }
  if (command === '--link') {
    const port = Number(process.env.INLOOP_PORT);
    const launch = Number.isInteger(port) && port > 0 ? readLaunch(port) : null;
    const identity = launch && launch.signedIn ? localIdentity() : null;
    if (!identity) {
      process.stderr.write(launch
        ? 'usernode-run-inloop: the app on this port was launched without a local sign-in (its worker sets its own '
          + 'USERNODE_JWT_PUBLIC_KEY, or it is the platform\'s own repository).\n'
        : `usernode-run-inloop: no app it launched is running on ${process.env.INLOOP_PORT || '$INLOOP_PORT'}; launch it first.\n`);
      process.exitCode = 2;
      return;
    }
    process.stdout.write(`${signedInLink(identity, launch.appId || LOCAL_APP_ID, port, process.argv[3] || '/')}\n`);
    return;
  }
  if (!command || command === '--help' || command === '-h') {
    process.stderr.write('usage: usernode-run-inloop <app command> [args...]\n'
      + '       usernode-run-inloop --stop           (stops the app it launched on $INLOOP_PORT)\n'
      + '       usernode-run-inloop --link [route]   (prints a link to that route, signed in)\n');
    process.exitCode = command ? 0 : 2;
    return;
  }
  let manifest;
  let env;
  try {
    manifest = readManifest(path.resolve('dapp.json'));
    env = environmentForInLoop(manifest, process.env);
  } catch (err) {
    process.stderr.write(`usernode-run-inloop: ${err.message}\n`);
    process.exitCode = 2;
    return;
  }

  let pkg;
  try { pkg = readJson(path.resolve('package.json')); } catch (err) {
    process.stderr.write(`usernode-run-inloop: package.json is not valid JSON (${err.message}); `
      + 'the image build would fail on it too.\n');
    process.exitCode = 2;
    return;
  }
  if (shouldRunBuild(pkg, env)) {
    const build = runBuild(env, process.cwd());
    if (!build.ok) {
      process.stderr.write(`usernode-run-inloop: \`npm run build\` failed (${build.reason}). `
        + 'Every staging and production image runs it, so this app would not deploy as it stands. '
        + 'Install dependencies first if they are missing (`npm ci`), fix the build, then launch '
        + 'again. INLOOP_SKIP_BUILD=1 boots without it, but the page will not be what users get.\n');
      process.exitCode = 2;
      return;
    }
  }

  const publicPort = Number(env.PORT);
  let appPort;
  try { appPort = await freePort(); } catch (err) {
    process.stderr.write(`usernode-run-inloop: could not reserve an internal port: ${err.message}\n`);
    process.exitCode = 2;
    return;
  }
  const routeAssets = routesPlatformAssets(process.cwd(), env);
  const assetOrigin = platformAssetOrigin(env);
  // Signed in as the platform would sign a person in (see SIGNED IN).
  const identity = signsIn(env, routeAssets) ? localIdentity() : null;
  const appId = String(env.USERNODE_APP_ID || '').trim() || LOCAL_APP_ID;
  if (identity) {
    env.USERNODE_JWT_PUBLIC_KEY = identity.publicKeyPem;
    env.USERNODE_APP_ID = appId;
  }
  const proxy = createFrontProxy({ appPort, assetOrigin, routeAssets });
  // The launch before this one on the same port, stopped first: a relaunch
  // after an edit is how an app is looked at again.
  if (await stopLaunch(publicPort)) {
    process.stderr.write(`usernode-run-inloop: stopped the app it launched earlier on ${publicPort}.\n`);
  }
  // Bound before the app starts, so a port still held by an earlier launch
  // stops here instead of leaving an app running that nothing fronts.
  try {
    await new Promise((resolve, reject) => {
      proxy.once('error', reject);
      proxy.listen(publicPort, '127.0.0.1', () => { proxy.off('error', reject); resolve(); });
    });
  } catch (err) {
    process.stderr.write(`usernode-run-inloop: cannot listen on ${publicPort}: ${err.message}`
      + ' (a process this command did not start holds it: an app started some other way. Stop that'
      + ' process; this command stops the launches it made itself)\n');
    process.exitCode = 2;
    return;
  }
  process.stderr.write(`usernode-run-inloop: open http://127.0.0.1:${publicPort} — `
    + (routeAssets ? 'the platform\'s /usernode-* assets are served there as in production, and ' : '')
    + `the app itself listens on internal port ${appPort}; browse ${publicPort}, not ${appPort}.\n`);
  if (identity) {
    process.stderr.write(`usernode-run-inloop: signed in as ${VIEWER.username}, as Homeroom signs a person in: open `
      + `${signedInLink(identity, appId, publicPort, '/')} (the app keeps the token as it does in Homeroom). `
      + '`usernode-run-inloop --link /some/route?demo=1` prints the same link for any route.\n');
  }

  const child = spawn(process.execPath, [path.join(__dirname, 'inloop-app-supervisor.js'), command, ...process.argv.slice(3)], {
    env: { ...env, PORT: String(appPort) }, stdio: ['inherit', 'inherit', 'inherit', 'ipc'], detached: true,
  });
  const launcherIdentity = readProcess(process.pid);
  let childIdentity = Number.isInteger(child.pid) ? readProcess(child.pid) : null;
  const saveLaunch = () => {
    if (launcherIdentity) recordLaunch(publicPort, {
      pid: process.pid, childPid: child.pid, launcher: launcherIdentity, child: childIdentity,
      startedAt: new Date().toISOString(),
      ...(identity ? { signedIn: true, appId } : {}),
    });
  };
  saveLaunch();
  let stopping = false;
  const finish = async (code) => {
    if (stopping) return;
    stopping = true;
    proxy.close();
    proxy.closeAllConnections();
    // Also handles failed spawns, npm/shell grandchildren, and an app that
    // ignores SIGTERM. The hard bound prevents a turn hanging indefinitely.
    const records = new Map([
      ...(launcherIdentity ? processTree(launcherIdentity) : []).filter((p) => p.pid !== process.pid),
      ...(childIdentity ? processGroup(childIdentity) : []),
    ].map((p) => [p.pid, p]));
    const deadline = Date.now() + STOP_WAIT_MS;
    // ChildProcess retains the handle we spawned, even if process inspection
    // is unavailable or the app changes its process title. Node closes that
    // handle on exit, so it cannot signal a subsequently reused PID.
    try { child.kill('SIGTERM'); } catch { /* failed spawn or already exited */ }
    await stopOwned([...records.values()], { waitMs: STOP_WAIT_MS });
    while (child.exitCode === null && child.signalCode === null && Date.now() < deadline) {
      await new Promise((resolve) => setTimeout(resolve, 50));
    }
    try { child.kill('SIGKILL'); } catch { /* already exited */ }
    forgetLaunch(publicPort, process.pid);
    process.exitCode = code;
    process.exit();
  };
  child.on('message', (message) => {
    if (message?.type === 'ready') {
      childIdentity = readProcess(child.pid);
      saveLaunch();
    } else if (message?.type === 'app-error') {
      process.stderr.write(`usernode-run-inloop: could not start app command: ${message.message}\n`);
      void finish(2);
    } else if (message?.type === 'app-exit') {
      void finish(message.code);
    }
  });
  process.once('SIGTERM', () => { void finish(0); });
  process.once('SIGINT', () => { void finish(0); });
  child.on('error', (err) => {
    process.stderr.write(`usernode-run-inloop: could not start app command: ${err.message}\n`);
    void finish(2);
  });
  child.on('exit', (code, signal) => {
    // Save descendants while the launcher is still their ancestor, including
    // servers whose npm/shell parent has already exited.
    void finish(code == null ? (signal ? 128 : 2) : code);
  });
}

if (require.main === module) main();

module.exports = {
  environmentForInLoop,
  readManifest,
  shouldRunBuild,
  untrackedFiles,
  excludeBuildOutputs,
  routesPlatformAssets,
  platformAssetOrigin,
  isPlatformAssetPath,
  createFrontProxy,
  PLATFORM_ASSET_PREFIXES,
  readLaunch,
  stopLaunch,
  VIEWER,
  LOCAL_APP_ID,
  localIdentity,
  viewerToken,
  signedInLink,
  signsIn,
};

{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    // #1079 chunk B moved two legacy modules into src/features/** as .js. They
    // are resolvable imports but deliberately NOT type-checked (checkJs stays
    // off): they are verbatim moves of untyped DOM code, and retyping them
    // would obscure that.
    "allowJs": true,
    "checkJs": false,
    // features/dev-console/store.ts is loaded two ways: by Vite, and DIRECTLY
    // by tests/dev-console-invariant.test.js through node's type-stripping
    // require. Node resolves relative specifiers by exact filename, so its one
    // import (../../lib/kit-surface.ts) has to carry the extension. Legal here
    // because noEmit is on — nothing rewrites the specifier on the way out.
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": { "@/*": ["./@/*"] }
  },
  "include": ["src", "@"]
}

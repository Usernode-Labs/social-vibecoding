{
  "name": "social-vibecoding-react",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:tokens": "node scripts/build-design-tokens.mjs",
    "build:catalog": "node scripts/build-design-system-catalog.mjs",
    "build:registry": "shadcn build",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "check:tokens": "node scripts/check-design-tokens.mjs",
    "check:design-system": "node scripts/check-design-system.mjs",
    "check:registry": "node scripts/check-shell-registry.mjs",
    "check:style-policy": "node scripts/check-style-policy.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check:harness": "node scripts/check-harness-policy.mjs",
    "query:design-system": "node scripts/query-design-system.mjs",
    "resolve:ui-workflow": "node ../tool/ui-workflow.mjs",
    "test:agent-battery": "node scripts/run-agent-battery.mjs",
    "test:content": "node --test scripts/check-content.test.mjs",
    "evaluate:agent-battery": "node scripts/run-live-agent-battery.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:native-bridge-contract": "playwright test tests/native-bridge-contract.spec.ts",
    "test:service-worker-contract": "playwright test --config playwright.service-worker.config.ts",
    "test:production-review": "CI=1 PLAYWRIGHT_PORT=4274 SV_PRODUCTION_READONLY=true SV_API_TARGET=https://example.invalid playwright test tests/notifications.production-review.spec.ts tests/apps-home.spec.ts tests/app-members.spec.ts tests/app-dev.spec.ts tests/dev-session.spec.ts tests/github-issues.spec.ts tests/group-discussion.spec.ts tests/shared-session.spec.ts tests/session-spec-viewer.spec.ts tests/activation-codes.spec.ts tests/admin-features.spec.ts tests/settings-feedback.spec.ts --grep 'production review mode'",
    "test:storybook": "vitest run --project=storybook",
    "check:storybook-build": "storybook build --test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:cutover-contract": "node scripts/check-cutover-contract.mjs",
    "check:cutover-ready": "node scripts/check-cutover-contract.mjs --require-ready"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.43",
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@shadcn/helpers": "^0.1.0",
    "@shadcn/react": "^0.2.1",
    "@tailwindcss/vite": "^4.1.0",
    "ai": "^7.0.40",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.1",
    "tailwind-merge": "^3.0.0",
    "tailwindcss": "^4.1.0",
    "tw-animate-css": "^1.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@chromatic-com/storybook": "^5.2.1",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.62.0",
    "@storybook/addon-a11y": "^10.5.5",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/addon-mcp": "^0.7.0",
    "@storybook/addon-vitest": "^10.5.5",
    "@storybook/react-vite": "^10.5.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/browser-playwright": "^4.1.10",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "eslint-plugin-storybook": "^10.5.5",
    "globals": "^15.0.0",
    "playwright": "^1.62.0",
    "shadcn": "^4.16.0",
    "storybook": "^10.5.5",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  }
}

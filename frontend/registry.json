{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "usernode-shell",
  "namespace": "usernode-shell",
  "homepage": "https://social-vibecoding.usernodelabs.org/react",
  "items": [
    {
      "name": "platform-icon",
      "type": "registry:component",
      "title": "Platform Icon",
      "description": "Canonical shell icon wrapper with governed size, alignment and accessibility behavior.",
      "author": "Usernode Labs",
      "dependencies": ["lucide-react"],
      "files": [
        {
          "path": "@/components/platform-icon.tsx",
          "type": "registry:component",
          "target": "@components/platform-icon.tsx"
        },
        {
          "path": "@/lib/utils.ts",
          "type": "registry:lib",
          "target": "@lib/utils.ts"
        }
      ],
      "categories": ["shell", "foundation", "accessibility"],
      "meta": {
        "authority": "design-system/catalog.json#platform-icon",
        "maturity": "stable",
        "scope": "shell"
      }
    },
    {
      "name": "theme-switcher",
      "type": "registry:component",
      "title": "Theme Switcher",
      "description": "Shell Light, Dark, and System preference selector using the owned elevated ToggleGroup selection contract and canonical theme persistence adapter.",
      "author": "Usernode Labs",
      "registryDependencies": ["toggle"],
      "dependencies": ["lucide-react"],
      "files": [
        {
          "path": "@/components/theme-switcher.tsx",
          "type": "registry:component",
          "target": "@components/theme-switcher.tsx"
        },
        {
          "path": "@/components/platform-icon.tsx",
          "type": "registry:component",
          "target": "@components/platform-icon.tsx"
        },
        {
          "path": "@/components/ui/toggle-group.tsx",
          "type": "registry:ui",
          "target": "@components/ui/toggle-group.tsx"
        },
        {
          "path": "@/lib/theme.ts",
          "type": "registry:lib",
          "target": "@lib/theme.ts"
        },
        {
          "path": "@/lib/utils.ts",
          "type": "registry:lib",
          "target": "@lib/utils.ts"
        }
      ],
      "categories": ["shell", "theme", "settings"],
      "meta": {
        "authority": "design-system/catalog.json#theme-switcher",
        "maturity": "candidate",
        "scope": "shell"
      }
    }
  ]
}

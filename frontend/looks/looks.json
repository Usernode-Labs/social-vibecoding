              "quiet": ":is(.bg-white,.bg-zinc-100,.border,.ui-btn-quiet):not(.border-red-400,.ui-btn-bad)",
              "line": ".ui-btn-line",
              "bad": ":is(.bg-red-500\\/10,.bg-red-50,.border-red-400,.ui-btn-bad)",
              "sm": ":is(.text-xs,.text-sm:not(.w-full),.py-1,.py-0\\.5,.py-1\\.5,.ui-btn-sm)",
              "block": ":is(.ui-btn-block,.w-full:not([class*=\":w-auto\"]))"
            }
          },
          {
            "to": "[data-new-message] .ms-auto > button",
            "parts": {
              "quiet": ".bg-zinc-100"
            }
          },
          {
            "to": ":is(.rf-go,.rf-desc-go,.rf-end-btn,.rf-morph,.rf-chip,[data-needs-vote-chip])",
            "parts": {
              "quiet": ":is(.rf-desc-go,.rf-end-btn:not(.rf-end-btn-go),.rf-morph:not([data-rf-morph=\"next\"]),.rf-chip:not([aria-checked=\"true\"]),[data-needs-vote-chip]:not([aria-pressed=\"true\"]))",
              "sm": "[data-needs-vote-chip]",
              "off": ":disabled"
            }
          },
          {
            "to": ":is(a[data-waiting-look-around][href=\"#apps\"],form[data-waiting-invite] button[type=\"submit\"],#waiting-about-save,#waiting-about-discovery > button,#auth-landing-screen [data-landing-invite-dead-continue])",
            "parts": {
              "quiet": ".bg-zinc-100",
              "block": ":is([data-waiting-look-around],[data-landing-invite-dead-continue])",
              "sm": ":is(#waiting-about-discovery > *)",
              "off": ":disabled"
            }
          },
          {
            "to": "#home-waitlist-card button:is(.bg-violet-600,.bg-zinc-100)",
            "parts": {
              "quiet": ".bg-zinc-100",
              "block": "",
              "off": ":disabled"
            }
          }
        ]
      },
      "row": {
        "to": ":is(.ui-lrow,.ui-row,.drawer-ver-row):is(#settings-root *)",
        "parts": {
          "tx": ":is(.ui-lrow-tx,.ui-row-tx)",
          "t": ":is(.ui-lrow-t,.ui-row-t,.drawer-ver-label)",
          "s": ":is(.ui-lrow-s,.ui-row-s)",
          "go": ".ui-lrow-go",
          "meta": ":is(.fr-meta,.ui-row-meta,.drawer-ver-value)",
          "on": ":is([aria-current=\"page\"],.ui-row-on)",
          "sm": ":is(.ui-row-sm,.settings-menu-row)",
          "wrap": "",
          "all": ""
        },
        "also": [
          {
            "to": ".rf-help-row",
            "parts": {
              "t": "span",
              "go": "svg:last-child",
              "sm": ""
            }
          },
          {
            "to": ".messages-object-card:is(.messages-message *)",
            "parts": {
              "tx": ".min-w-0",
              "t": ".text-base",
              "s": ".text-sm",
              "go": "span:last-child"
            }
          }
        ]
      },
      "tabs": {
        "to": "#notifications-screen-tabs",
        "skip": [
          ".tabs .end",
          ".tabs .end .search",
          ".tabs .end .inp"
        ],
        "also": [
          {
            "to": "[data-new-message] [role=\"tablist\"]"
          }
        ]
      },
      "tab": {
        "to": "#notifications-screen-tabs > [role=\"tab\"]",
        "parts": {
          "on": "[aria-selected=\"true\"]"
        },
        "also": [
          {
            "to": "[data-new-message] [role=\"tab\"]",
            "parts": {
              "on": "[aria-selected=\"true\"]"
            }
          }
        ]
      },
      "evt": {
        "to": "#dev-topic-thread #gc-thread-messages .dev-request-event",
        "parts": {
          "ei": ".dev-request-event-glyph"
        },
        "also": [
          {
            "to": ":is(button:is(.messages-bot-news > *),div:is(.messages-bot-settled-run > *))",
            "parts": {
              "ei": ":is([data-bot-badge],[data-bot-settled-tile])"
            }
          }
        ]
      },
      "sechead": {
        "to": "#dev-topic-thread .dev-request #gc-thread-messages",
        "parts": {
          "cap": ".messages-reply-count"
        },
        "skip": [
          ".sechead"
        ]
      },
      "purpose": {
        "to": ".settings-frame-purpose"
      },
      "sub22": {
        "to": ".settings-page-title:is(#settings-root *)"
      },
      "search": {
        "to": ".ui-search:is(#settings-root *)",
        "parts": {
          "inp": ".settings-filter",
          "flush": ""
        }
      },
      "inp": {
        "to": ":is(.settings-filter,.ui-inp,:is(input:not([type=\"checkbox\"],[type=\"radio\"],[type=\"file\"],[type=\"range\"],[type=\"hidden\"]),select,textarea):is(#settings-section-content *)):is(#settings-root *)",
        "parts": {
          "code": ".ui-inp-code",
          "focus": ":focus-within"
        },
        "also": [
          {
            "to": ".rf-ask-form input",
            "parts": {
              "val": "",
              "focus": ":focus"
            }
          },
          {
            "to": ":is(:is(:is(#auth-login-screen,#auth-register-screen,#auth-waitlist-screen,#auth-more-screen),[data-sign-in-sheet]) .rounded-2xl.overflow-hidden input:not([type=\"checkbox\"],[type=\"radio\"]),#recovery-email-input,#waitlist-confirm-email,#waiting-about-country,form[data-waiting-invite] input[type=\"url\"])",
            "parts": {
              "val": "",
              "focus": ":focus"
            }
          },
          {
            "to": "#home-waitlist-card input",
            "parts": {
              "val": "",
              "focus": ":focus"
            }
          }
        ]
      },
      "tog": {
        "to": ".un-switch:is(#settings-root *)",
        "parts": {
          "on": ":checked"
        }
      },
      "pill": {
        "to": ".ui-pill:is(#settings-root *)",
        "parts": {
          "ok": ".ui-pill-ok",
          "wait": ".ui-pill-wait",
          "bad": ".ui-pill-bad"
        }
      },
      "link": {
        "to": ":is(.ui-link,:is(button,a):is(.text-violet-600,.text-violet-700,.underline,.text-red-700:not(.bg-red-50,.bg-red-500\\/10,.w-full)):not(.ui-lrow,.ui-row,.border,.bg-violet-600,.bg-zinc-100,.ui-btn)):is(#settings-root *)",
        "parts": {
          "bad": ":is(.ui-link-bad,.text-red-700,.text-red-600)"
        },
        "also": [
          {
            "to": "#waiting-about-skip"
          },
          {
            "to": ":is(#home-waitlist-card,#home-verify-card) :is(button,a):is(.text-violet-700,.text-zinc-500)"
          }
        ]
      },
      "secnote": {
        "to": ":is(.ui-secblurb,.ui-note):is(#settings-root *)"
      },
      "chk": {
        "to": ".ui-chk:is(#settings-root *)",
        "parts": {
          "on": ".ui-chk-on",
          "round": ""
        }
      },
      "fields": {
        "to": ".ui-fields:is(#settings-root *)"
      },
      "sub17": {
        "to": ":is(.rf-bar-title,.rf-why-head,.rf-sub h2)",
        "also": [
          {
            "to": ":is(#home-waitlist-card h3,#home-verify-card h2)"
          }
        ]
      },
      "av": {
        "to": "#settings-profile-card > span[aria-hidden]:is(#settings-root *)"
      }
    }
  }

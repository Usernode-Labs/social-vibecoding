  "wear": {
    "note": "What the product's own markup wears. A conversation is drawn by the product's renderer, not by kit components, so for each kit component named here (roots) every kit rule that mentions it is repeated for the product's class (to), with the component's inner classes swapped for the product's (parts: a kit class, or a state the kit writes as a class, to a product selector). skip lists tour selectors left out. A part only counts inside a rule that names its root. The composer's field is not worn: the kit draws a placeholder's words, not a field (app.css, THE FRAME IN THE SHELL). The stand-alone pages a visitor signs in on (features/auth: sign-in, register, the waitlist form, more ways) are the product's own forms and wear the title, the card and the button; their one accent-filled control is the primary button, a white or grey pill a quiet one. Settings' own grouped lists (@/components/ui/grouped-list, named ui-glist and ui-lrow) wear the card and the row inside #settings-section-content, scoped with :where() inside the compound so a rule naming the row twice (.row+.row) stays one selector. Edit profile (features/profile/profile-edit-sheet.tsx) is the product's dialog: its title, group labels, groups and Save wear the title, the cap, the card and the button; its rows are dressed by hand in app.css, since a field row is a label over its box, not the kit's one-line row. The bell's sheet (#notifications-sheet) stays the product's and wears the card on each of its cards and the look's tabs on its Unread and All (a tab that is on is the one aria-selected). An item's page (a request, a change: features/dev-board/topic) keeps the product's own discussion: the stream wears the card (\"also\": a second wearer written as a selector of its own, since it needs two ids to outweigh the standard look's rule and :is() would lift every other wearer with it), the line that counts the replies wears a section's label (cap, and sechead for the looks that draw a section's label larger; the section head's own box is skipped, the stream is not one), and a line of what happened wears the event (evt).",
    "roots": {
      "post": {
        "to": ".messages-message",
        "parts": {
          "who": ".messages-message-author",
          "when": ".messages-message-head time",
          "txt": ".messages-markdown"
        },
        "skip": [
          ".post .txt b"
        ]
      },
      "day": {
        "to": ".messages-day"
      },
      "dhead": {
        "to": ".messages-thread-header",
        "parts": {
          "t": ".messages-thread-name",
          "s": ".messages-thread-sub"
        }
      },
      "composer": {
        "to": ".messages-composer-card",
        "parts": {
          "send": ".messages-send",
          "go": ":not(:disabled)"
        }
      },
      "ib": {
        "to": ":is(.messages-thread-action,.messages-composer-action)"
      },
      "cap": {
        "to": "#dev-topic-thread .dev-request .messages-reply-count",
        "also": [
          {
            "to": ".un-group-header:where(#profile-edit-sheet *)"
          },
          {
            "to": ":is(.dev-ws > [data-project-frame=\"all-items\"] ~ .dev-ws-tabbody [data-ws-themes-head],.dev-ws > [data-project-frame=\"all-items\"] ~ .dev-ws-tabbody .dev-ws-sort > .dev-ws-eyebrow)"
          }
        ]
      },
      "card": {
        "to": ":is(.dev-request-ask,.dev-change-pair .dev-change-gate,.ui-glist:where(#settings-section-content *),:is(:is(#auth-login-screen,#auth-register-screen,#auth-waitlist-screen,#auth-more-screen),[data-sign-in-sheet]) .rounded-2xl.overflow-hidden,#auth-waiting-screen :is([data-waiting-queued],[data-waiting-invite]),#app-menu-homeroom-card,.un-group:where(#profile-edit-sheet *),.notifications-card:where(#notifications-sheet *),.dev-ws > [data-project-frame=\"all-items\"] ~ .dev-ws-tabbody .dev-ws-theme)",
        "also": [
          {
            "to": "#dev-topic-thread .dev-request #gc-thread-messages:is([data-language=\"request\"],[data-language=\"change\"])"
          }
        ]
      },
      "title": {
        "to": ":is(.settings-page-title,#first-session-make-title,:is(#auth-login-screen,#auth-register-screen,#auth-waitlist-screen,#auth-more-screen,#auth-waiting-screen) h1,#profile-edit-sheet > div:first-child)"
      },
      "btn": {
        "to": ":is(:is(#auth-login-screen,#auth-register-screen,#auth-waitlist-screen,#auth-more-screen) :is(button,a):is(.bg-violet-600,.rounded-full:is(.bg-white,.bg-zinc-100)):not([data-auth-back]),[data-sign-in-sheet] [role=\"dialog\"] button.bg-violet-600,[data-public-profile-frame] button:is(.bg-violet-600,.bg-zinc-100),#improve-row-feedback,#profile-edit-save)",
        "parts": {
          "quiet": ":is(.bg-white,.bg-zinc-100)"
        }
      },
      "row": {
        "to": ".ui-lrow:where(#settings-section-content *)",
        "parts": {
          "tx": ".ui-lrow-tx",
          "t": ".ui-lrow-t",
          "s": ".ui-lrow-s",
          "go": ".ui-lrow-go"
        }
      },
      "tabs": {
        "to": "#notifications-screen-tabs",
        "skip": [
          ".tabs .end",
          ".tabs .end .search",
          ".tabs .end .inp"
        ]
      },
      "tab": {
        "to": "#notifications-screen-tabs > [role=\"tab\"]",
        "parts": {
          "on": "[aria-selected=\"true\"]"
        }
      },
      "evt": {
        "to": "#dev-topic-thread #gc-thread-messages .dev-request-event",
        "parts": {
          "ei": ".dev-request-event-glyph"
        }
      },
      "sechead": {
        "to": "#dev-topic-thread .dev-request #gc-thread-messages",
        "parts": {
          "cap": ".messages-reply-count"
        },
        "skip": [
          ".sechead"
        ]
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://social-vibecoding.usernodelabs.org/react/design-system/catalog.schema.json",
  "title": "Resolved Usernode shell component catalog",
  "type": "object",
  "required": ["generatedFrom", "scope", "authority", "components"],
  "properties": {
    "generatedFrom": { "type": "array", "minItems": 2, "items": { "type": "string" } },
    "scope": { "type": "object" },
    "authority": { "type": "object" },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "module",
          "export",
          "owner",
          "maturity",
          "distribution",
          "variants",
          "tokens",
          "accessibility",
          "dataBoundary",
          "responsive",
          "deprecation",
          "evidence"
        ]
      }
    }
  }
}

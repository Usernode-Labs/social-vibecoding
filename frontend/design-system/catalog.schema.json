{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://social-vibecoding.usernodelabs.org/react/design-system/catalog.schema.json",
  "title": "Resolved Usernode shell component catalog",
  "type": "object",
  "required": ["generatedFrom", "scope", "authority", "components"],
  "properties": {
    "generatedFrom": { "type": "array", "minItems": 2, "items": { "type": "string" } },
    "scope": { "type": "object" },
    "authority": { "type": "object" },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "tier": { "enum": ["element", "block", "feature"] },
          "exports": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "performance": { "$ref": "#/$defs/performance" },
          "content": { "$ref": "#/$defs/content" }
        },
        "required": [
          "id",
          "name",
          "tier",
          "module",
          "export",
          "exports",
          "owner",
          "maturity",
          "distribution",
          "variants",
          "tokens",
          "accessibility",
          "dataBoundary",
          "responsive",
          "deprecation",
          "evidence"
        ]
      }
    }
  },
  "$defs": {
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expectedCollectionSize",
        "updateFrequency",
        "stateScope",
        "virtualization",
        "mountPolicy",
        "sensitiveInteractions",
        "followUp"
      ],
      "properties": {
        "expectedCollectionSize": {
          "type": "object",
          "additionalProperties": false,
          "required": ["category", "rationale"],
          "properties": {
            "category": {
              "enum": ["single", "small", "medium", "large", "unbounded"]
            },
            "rationale": { "type": "string", "minLength": 1 }
          }
        },
        "updateFrequency": {
          "enum": ["static", "occasional", "interactive", "streaming"]
        },
        "stateScope": {
          "enum": ["local", "shared", "global", "mixed"]
        },
        "virtualization": {
          "enum": ["not-required", "review-later", "required"]
        },
        "mountPolicy": { "type": "string", "minLength": 1 },
        "sensitiveInteractions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "followUp": {
          "enum": ["none", "profile-before-stable", "profile-before-cutover"]
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer", "canonicalTerms", "requiredStates", "visibleLabelAccessibilityName", "reviewedFailureModes"],
      "properties": {
        "layer": { "enum": ["glance", "read", "expert"] },
        "canonicalTerms": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "requiredStates": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "visibleLabelAccessibilityName": { "const": "match-or-prefix" },
        "reviewedFailureModes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    }
  }
}

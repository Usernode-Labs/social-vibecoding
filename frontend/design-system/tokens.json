{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$extensions": {
    "org.usernode": {
      "scope": "shell",
      "status": "candidate",
      "description": "Canonical design-token source for the Social Vibecoding React shell. Child apps are explicitly out of scope."
    }
  },
  "foundation": {
    "font": {
      "sans": {
        "$type": "fontFamily",
        "$value": ["Geist Variable", "sans-serif"]
      }
    },
    "radius": {
      "base": {
        "$type": "dimension",
        "$value": {
          "value": 0.625,
          "unit": "rem"
        }
      }
    }
  },
  "semantic": {
    "light": {
      "$type": "color",
      "background": { "$value": { "colorSpace": "oklch", "components": [1, 0, 0] } },
      "foreground": { "$value": { "colorSpace": "oklch", "components": [0.145, 0, 0] } },
      "card": { "$value": { "colorSpace": "oklch", "components": [1, 0, 0] } },
